<Project Sdk="Microsoft.NET.Sdk">

  <!-- The feature slices host Carter endpoints, so this module needs the ASP.NET shared framework.
       Taught in plan-business-tutorial/02-mediator-own-vs-free.md §4, Step 1. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Deliberately NO reference to Erp.Shared.Infrastructure: a module codes against the interfaces in
       Erp.Shared.BuildingBlocks (IDbConnectionFactory, ICurrentUser), never the implementations. Only
       Erp.Api references Infrastructure. See plan-business-tutorial/01-solution-setup.md §3. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Erp.Shared.BuildingBlocks\Erp.Shared.BuildingBlocks.csproj" />
  </ItemGroup>

  <!-- Phase 15: Sales references the whole Inventory ASSEMBLY to reach its published contract
       (Erp.Modules.Inventory.Contracts.IStockReservation). Inventory's implementation is `internal`, so this
       reference exposes ONLY the contract — the compiler is now the wall, not the absent reference. This edge
       must stay one-way (Inventory never references Sales) or it becomes a cycle. See
       plan-business-tutorial/15-scaling-the-wall.md. -->
  <ItemGroup>
    <ProjectReference Include="..\Inventory\Erp.Modules.Inventory.csproj" />
  </ItemGroup>

  <!-- Ship each module's SQL as embedded resources so the host's DatabaseInitializer can apply them
       regardless of the working directory (Phase 3 §7). -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Sql\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
