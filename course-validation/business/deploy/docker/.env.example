# Copy to .env (same folder), fill in, and keep it private: chmod 600 .env. Never commit .env.
# Make each password with:  openssl rand -hex 24

# The address people type. With a real domain pointing at this server, Caddy gets an HTTPS certificate by itself.
# Use localhost to try everything on one machine.
ERP_DOMAIN=erp.example.ph

POSTGRES_PASSWORD=
ERP_OWNER_PASSWORD=
ERP_APP_PASSWORD=

# The certificate that encrypts sign-in keys at rest: secrets/dataprotection.pfx, and its password.
DATAPROTECTION_CERTIFICATE_PASSWORD=

# First install only: the first administrator. Remove both after they have signed in and changed the password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Printed on every invoice, exactly as on the BIR Certificate of Registration (RR 7-2024 Sec. 6(B)).
COMPANY_NAME=
# Optional: the DTI business name or trade name, printed under the registered name.
COMPANY_TRADE_NAME=
# TIN with the 5-digit branch code, e.g. 123-456-789-00000.
COMPANY_TIN=
COMPANY_ADDRESS=

# Vat (VAT-registered), PercentageTax (non-VAT, subject to percentage tax) or Exempt (neither).
TAX_REGIME=Vat
# The VAT rate as a fraction. Used only when TAX_REGIME=Vat; each invoice keeps the rate it was issued with.
TAX_VAT_RATE=0.12

# Must contain the word "Invoice": SALES INVOICE, CHARGE INVOICE, SERVICE INVOICE...
INVOICE_TITLE=SALES INVOICE
# From the BIR once the system is registered (CAS): the Permit to Use or Acknowledgement Certificate Control
# Number, the approved series range, and its date issued (mm/dd/yyyy). Printed at the bottom of every invoice.
BIR_PERMIT_NUMBER=
BIR_SERIES_RANGE=
BIR_DATE_ISSUED=

# For "forgot password" emails. Without a host, those emails go to the app's log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: where logs, traces and metrics go (an OTLP endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=

TZ=Asia/Manila
BACKUP_TIME=01:00
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups
