<Project Sdk="Microsoft.NET.Sdk">

  <!-- The feature slices host Carter endpoints, so this module needs the ASP.NET shared framework.
       Taught in plan-business-tutorial/02-mediator-own-vs-free.md §4, Step 1. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Deliberately NO reference to Erp.Shared.Infrastructure: a module codes against the interfaces in
       Erp.Shared.Common (IDbConnectionFactory, ICurrentUser), never the implementations. Only Erp.Api
       references Infrastructure. See plan-business-tutorial/01-solution-setup.md §3. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Erp.Shared.BuildingBlocks\Erp.Shared.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\Erp.Shared.Common\Erp.Shared.Common.csproj" />
    <ProjectReference Include="..\..\Shared\Erp.Shared.Messaging\Erp.Shared.Messaging.csproj" />
  </ItemGroup>

  <!-- Ship each module's SQL as embedded resources so the host's DatabaseInitializer can apply them
       regardless of the working directory (Phase 3 §7). -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Sql\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
