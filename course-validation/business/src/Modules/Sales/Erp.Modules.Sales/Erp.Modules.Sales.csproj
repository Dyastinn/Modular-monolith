<Project Sdk="Microsoft.NET.Sdk">

  <!-- Endpoints are Carter modules, so this project needs the ASP.NET shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Sales may see Inventory's CONTRACTS, never Inventory itself. No reference to Erp.Shared.Infrastructure:
       a module codes against BuildingBlocks interfaces, never the implementations. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Erp.Shared.BuildingBlocks\Erp.Shared.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Inventory\Erp.Modules.Inventory.Contracts\Erp.Modules.Inventory.Contracts.csproj" />
  </ItemGroup>

  <!-- Everything here is internal. Erp.Api may see it only because the Mediator source generator runs there;
       test projects may see it to test it. Never another module. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Api" />
    <InternalsVisibleTo Include="Erp.Modules.Sales.UnitTests" />
    <InternalsVisibleTo Include="Erp.Integration.Tests" />
  </ItemGroup>

  <!-- Stored procedures and seed scripts travel inside the assembly, so migrations can apply them anywhere. -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Sql\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
