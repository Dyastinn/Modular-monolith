<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Another module only through its .Contracts; never Erp.Shared.Infrastructure. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Erp.Shared.BuildingBlocks\Erp.Shared.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Erp.Modules.Inventory.Contracts\Erp.Modules.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\Sales\Erp.Modules.Sales.Contracts\Erp.Modules.Sales.Contracts.csproj" />
    <ProjectReference Include="..\..\Invoicing\Erp.Modules.Invoicing.Contracts\Erp.Modules.Invoicing.Contracts.csproj" />
  </ItemGroup>

  <!-- Erp.Api: the Mediator source generator runs there. Never grant this to another module. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Api" />
    <InternalsVisibleTo Include="Erp.Modules.Inventory.UnitTests" />
    <InternalsVisibleTo Include="Erp.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Sql\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
