@implements IDisposable
@inject Notices Notices

@* The status line. An error carries its code, linked to the page that explains it and its fix. *@
@if (Notices.Current is not null)
{
    var notice = Notices.Current;
    @if (notice.IsError)
    {
        <p class="notice error" role="alert">
            <strong>Error:</strong> @notice.Text
            @if (notice.Code is not null)
            {
                <text> </text><a href="@($"errors/{notice.Code}")">What does @notice.Code mean?</a>
            }
        </p>
    }
    else
    {
        <p class="notice" role="status">@notice.Text</p>
    }
}

@code {
    protected override void OnInitialized() => Notices.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Notices.Changed -= Refresh;
}
