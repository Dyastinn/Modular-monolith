@* A short table of tickets for Home: number, subject (the link), status, priority for staff, and when it last changed. *@
<TableBox Label="@Label">
    <table>
        <thead>
            <tr>
                <th scope="col" class="num">#</th>
                <th scope="col">Subject</th>
                <th scope="col">Status</th>
                @if (ShowPriority)
                {
                    <th scope="col">Priority</th>
                }
                <th scope="col">Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Items)
            {
                <tr>
                    <td class="num">@t.Id</td>
                    <td class="truncate"><a href="@($"tickets/{t.Id}")">@t.Subject</a></td>
                    <td>@t.Status</td>
                    @if (ShowPriority)
                    {
                        <td><PriorityText Value="@t.Priority" /></td>
                    }
                    <td><TimeAgo Utc="t.UpdatedUtc" /></td>
                </tr>
            }
        </tbody>
    </table>
</TableBox>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<TicketSummary> Items { get; set; } = [];
    [Parameter] public bool ShowPriority { get; set; }
}
