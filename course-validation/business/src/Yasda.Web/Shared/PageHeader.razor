@* The top of every page: where it sits (a trail of links, for a page under a list), its title and status, what can
   be done here, and a line saying what the page is for. *@
@if (Trail is not null)
{
    <nav aria-label="Breadcrumb" class="trail">
        @foreach (var (text, href) in Trail)
        {
            <a href="@href">@text</a><text> › </text>
        }
        <span aria-current="page">@Title</span>
    </nav>
}
<h1>@Title @if (Status is not null) { <text> · </text>@Status }</h1>
@if (Description is not null)
{
    <p class="muted">@Description</p>
}
@if (Actions is not null)
{
    <div class="actions">@Actions</div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<(string Text, string Href)>? Trail { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
}
