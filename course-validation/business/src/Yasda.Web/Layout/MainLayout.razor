@inherits LayoutComponentBase
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Nav

@* DESIGN.md's shell: one header line (logo and name, then the navigation), a rule, then the page. *@
<div class="page">
    <header class="site-head">
        <p class="brand"><img src="logo.svg" alt="" width="32" height="32" /> YASDA</p>
        <AuthorizeView>
            <NavMenu />
        </AuthorizeView>
    </header>
    <hr />
    <main>
        @Body
    </main>
</div>

@code {
    // A temporary password from an admin must be replaced before anything else.
    protected override async Task OnParametersSetAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        if (Auth.User is not null && Auth.User.MustChangePassword && !Nav.Uri.EndsWith("/change-password"))
            Nav.NavigateTo("change-password");
    }
}
