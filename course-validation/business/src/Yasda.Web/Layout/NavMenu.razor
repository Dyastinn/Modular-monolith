@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Nav

@* Each person sees the parts of the system their role uses, in the same order on every page. The API enforces the
   same rules; hiding a link is only a convenience. *@
<nav aria-label="Main">
    <ul class="links">
        <li><NavItem Href="">Home</NavItem></li>
        <li><NavItem Href="tickets">@(TicketChoices.IsStaff(Auth.User?.Role) ? "Tickets" : "My tickets")</NavItem></li>
        <li><NavItem Href="tickets/new">New ticket</NavItem></li>
        <AuthorizeView Roles="@($"{Roles.TeamLead},{Roles.Admin}")">
            <li><NavItem Href="categories">Categories</NavItem></li>
            <li><NavItem Href="sla-policies">SLA policies</NavItem></li>
        </AuthorizeView>
        <AuthorizeView Roles="@Roles.Admin">
            <li><NavItem Href="users">Users</NavItem></li>
            <li><NavItem Href="teams">Teams</NavItem></li>
            <li><NavItem Href="sign-in-log">Sign-in log</NavItem></li>
        </AuthorizeView>
        <li><NavItem Href="errors">Error codes</NavItem></li>
        <li><NavItem Href="change-password">Change password</NavItem></li>
        <li><button type="button" class="link" @onclick="SignOut">Sign out</button></li>
    </ul>
</nav>

@code {
    private async Task SignOut()
    {
        await Auth.SignOutAsync(false);
        Nav.NavigateTo("login");
    }
}
