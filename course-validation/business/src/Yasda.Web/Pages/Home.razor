@page "/"
@inject ApiClient Api
@inject CookieAuthenticationStateProvider Auth
@inject TimeProvider Time

<PageTitle>Home · YASDA</PageTitle>

@* DESIGN.md §4.1: what needs this person right now, most urgent first, then the fastest way to act on it. Empty
   sections are hidden, except the first. *@
@if (IsStaff)
{
    <PageHeader Title="@Greeting" />

    @if (_needsYou is null)
    {
        <p role="status">Loading…</p>
    }
    else
    {
        <h2>Needs you now (@_needsYou.TotalCount)</h2>
        @if (_needsYou.Items.Count == 0)
        {
            <p>Nothing needs you right now.</p>
        }
        else
        {
            <TicketTable Label="Needs you now" Items="_needsYou.Items" ShowPriority="true" />
        }
        <p><a href="tickets?assigned=me">Show all in My queue</a></p>

        <h2>Queues</h2>
        <p>
            <a href="tickets?assigned=me">My queue</a> ·
            <a href="tickets?assigned=unassigned&status=New">Unassigned (@_unassigned?.TotalCount)</a> ·
            <a href="tickets?assigned=me&status=Pending">Waiting on requester (@_waitingOnRequester?.TotalCount)</a> ·
            <a href="tickets">All tickets</a>
        </p>
    }
}
else
{
    <PageHeader Title="How can we help?">
        <Actions>
            <a class="button" href="tickets/new">Submit a ticket</a>
            <a class="button" href="tickets">Check my tickets</a>
        </Actions>
    </PageHeader>

    @if (_waitingOnYou is null)
    {
        <p role="status">Loading…</p>
    }
    else
    {
        <h2>Waiting on you (@_waitingOnYou.TotalCount)</h2>
        @if (_waitingOnYou.Items.Count == 0)
        {
            <p>Nothing needs you right now.</p>
        }
        else
        {
            <TicketTable Label="Waiting on you" Items="_waitingOnYou.Items" />
        }

        @if (_recent is not null && _recent.Items.Count > 0)
        {
            <h2>Your recent tickets</h2>
            <TicketTable Label="Your recent tickets" Items="_recent.Items" />
        }
    }
}

@code {
    private PagedResult<TicketSummary>? _needsYou, _unassigned, _waitingOnRequester, _waitingOnYou, _recent;

    private bool IsStaff => TicketChoices.IsStaff(Auth.User?.Role);

    private string Greeting
    {
        get
        {
            var hour = Time.GetLocalNow().Hour;
            var part = hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening";
            return $"Good {part}, {Auth.User?.FullName}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        if (IsStaff)
        {
            // Until SLA clocks exist, "needs you" means your open tickets, most urgent first.
            _needsYou = await Api.Get<PagedResult<TicketSummary>>("api/tickets?assigned=me&status=Open&sort=priority&desc=true&pageSize=10");
            _unassigned = await Api.Get<PagedResult<TicketSummary>>("api/tickets?assigned=unassigned&status=New&pageSize=1");
            _waitingOnRequester = await Api.Get<PagedResult<TicketSummary>>("api/tickets?assigned=me&status=Pending&pageSize=1");
        }
        else
        {
            // A requester only ever gets their own tickets: the API sees to that.
            _waitingOnYou = await Api.Get<PagedResult<TicketSummary>>("api/tickets?status=Pending&sort=updatedUtc&desc=true&pageSize=10");
            _recent = await Api.Get<PagedResult<TicketSummary>>("api/tickets?sort=updatedUtc&desc=true&pageSize=10");
        }
    }
}
