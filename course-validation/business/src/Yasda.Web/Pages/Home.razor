@page "/"

<PageTitle>Home · YASDA</PageTitle>

<AuthorizeView Context="auth">
    <PageHeader Title="@($"Good day, {auth.User.Identity?.Name}")">
        <Description>Here's where your work starts.</Description>
    </PageHeader>

    <ul>
        <AuthorizeView Roles="@StaffRoles" Context="staff">
            <li><a href="tickets?assigned=me">My queue</a>: the tickets you're working on.</li>
            <li><a href="tickets?assigned=unassigned">Unassigned</a>: tickets nobody has taken yet.</li>
        </AuthorizeView>
        <li><a href="tickets/new">New ticket</a>: ask for help.</li>
        <li><a href="tickets">Tickets</a>: @(IsStaff(auth) ? "every ticket, with filters." : "the tickets you filed, and their answers.")</li>
        <AuthorizeView Roles="@Roles.Admin" Context="admin">
            <li><a href="users">Users</a>: add staff and requesters, set their roles, reset passwords.</li>
            <li><a href="sign-in-log">Sign-in log</a>: who signed in, and every failed attempt.</li>
        </AuthorizeView>
        <li><a href="change-password">Change password</a>: choose a new one any time.</li>
        <li><a href="errors">Error codes</a>: what each message means and how to fix it.</li>
    </ul>
</AuthorizeView>

@code {
    private static readonly string StaffRoles = $"{Roles.Agent},{Roles.TeamLead},{Roles.Admin}";

    private static bool IsStaff(AuthenticationState auth) =>
        TicketChoices.IsStaff(auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);
}
