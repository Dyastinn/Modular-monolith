@page "/sla-policies"
@attribute [Authorize(Roles = Roles.TeamLead + "," + Roles.Admin)]
@inject ApiClient Api

<PageTitle>SLA policies · YASDA</PageTitle>

<PageHeader Title="SLA policies">
    <Description>
        How long a team has to answer a new ticket and to resolve it, for each priority, counting open hours only (see Business hours).
        A change applies to tickets still running as well: their deadlines are worked out again with the new numbers.
    </Description>
</PageHeader>

@if (_edits is null)
{
    <p role="status">Loading…</p>
}
else
{
    @foreach (var edit in _edits)
    {
        <EditForm Model="edit" OnSubmit="@(() => Save(edit))">
            <fieldset>
                <legend>@edit.Priority</legend>
                <div class="field">
                    <label for="@($"respond-{edit.Priority}")">Respond within, in minutes</label>
                    <InputNumber id="@($"respond-{edit.Priority}")" @bind-Value="edit.RespondMinutes" min="1" required />
                    <span class="hint">That is @Format.Span(TimeSpan.FromMinutes(edit.RespondMinutes)).</span>
                </div>
                <div class="field">
                    <label for="@($"resolve-{edit.Priority}")">Resolve within, in minutes</label>
                    <InputNumber id="@($"resolve-{edit.Priority}")" @bind-Value="edit.ResolveMinutes" min="1" required />
                    <span class="hint">That is @Format.Span(TimeSpan.FromMinutes(edit.ResolveMinutes)).</span>
                </div>
                <p class="muted">Last changed by @edit.UpdatedByName, <TimeAgo Utc="edit.UpdatedUtc" />.</p>
                <div class="actions">
                    <button type="submit" disabled="@Api.Busy">Save @edit.Priority</button>
                </div>
            </fieldset>
        </EditForm>
    }

    <h2>Different numbers for one category</h2>
    <p>
        A category can have its own numbers for a priority, for example a shorter answer time for "Outage". Tickets of that category and priority
        use them instead of the numbers above. Remove them and the category goes back to the numbers above. A change applies to tickets
        still running as well.
    </p>
    @if (_categoryPolicies.Count == 0)
    {
        <p>No category has its own numbers yet.</p>
    }
    else
    {
        <TableBox Label="Category policies">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Category</th>
                        <th scope="col">Priority</th>
                        <th scope="col">Respond within</th>
                        <th scope="col">Resolve within</th>
                        <th scope="col">Last changed by</th>
                        <th scope="col">Remove</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var own in _categoryPolicies)
                    {
                        var name = CategoryName(own.CategoryId);
                        <tr>
                            <td>@name</td>
                            <td>@own.Priority</td>
                            <td>@Format.Span(TimeSpan.FromMinutes(own.RespondMinutes))</td>
                            <td>@Format.Span(TimeSpan.FromMinutes(own.ResolveMinutes))</td>
                            <td>@own.UpdatedByName</td>
                            <td>
                                @if (_removing == (own.CategoryId, own.Priority))
                                {
                                    <button type="button" @onclick="() => RemoveOwn(own)" disabled="@Api.Busy" aria-label="@($"Yes, remove the {own.Priority} numbers of {name}")">Remove</button>
                                    <button type="button" @onclick="() => _removing = null">Not yet</button>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => _removing = (own.CategoryId, own.Priority)" aria-label="@($"Remove the {own.Priority} numbers of {name}")">Remove…</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </TableBox>
        @if (_removing is not null)
        {
            <p role="alert">Remove these numbers? That category and priority go back to the numbers above.</p>
        }
    }

    @if (_categories.Count > 0)
    {
        <EditForm Model="this" OnSubmit="SaveOwn">
            <fieldset>
                <legend>Set a category's own numbers</legend>
                <div class="field">
                    <label for="own-category">Category</label>
                    <InputSelect id="own-category" @bind-Value="_ownCategoryId">
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="own-priority">Priority</label>
                    <InputSelect id="own-priority" @bind-Value="_ownPriority">
                        @foreach (var priority in TicketChoices.Priorities)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="own-respond">Respond within, in minutes</label>
                    <InputNumber id="own-respond" @bind-Value="_ownRespondMinutes" min="1" required />
                </div>
                <div class="field">
                    <label for="own-resolve">Resolve within, in minutes</label>
                    <InputNumber id="own-resolve" @bind-Value="_ownResolveMinutes" min="1" required />
                </div>
                <div class="actions">
                    <button type="submit" disabled="@Api.Busy">Save category numbers</button>
                </div>
            </fieldset>
        </EditForm>
    }
}

@code {
    // One per priority: the numbers as typed, until Save sends them.
    private sealed class PolicyEdit
    {
        public string Priority { get; init; } = "";
        public int RespondMinutes { get; set; }
        public int ResolveMinutes { get; set; }
        public string UpdatedByName { get; init; } = "";
        public DateTime UpdatedUtc { get; init; }
    }

    private List<PolicyEdit>? _edits;
    private List<CategorySlaPolicy> _categoryPolicies = [];
    private List<Category> _categories = [];
    private long _ownCategoryId;
    private string _ownPriority = "High";
    private int _ownRespondMinutes = 60;
    private int _ownResolveMinutes = 240;
    private (long CategoryId, string Priority)? _removing;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var policies = await Api.Get<List<SlaPolicy>>("api/sla/policies");
        if (policies is null) return;

        var edits = new List<PolicyEdit>();
        foreach (var policy in policies)
        {
            edits.Add(new PolicyEdit
            {
                Priority = policy.Priority,
                RespondMinutes = policy.RespondMinutes,
                ResolveMinutes = policy.ResolveMinutes,
                UpdatedByName = policy.UpdatedByName,
                UpdatedUtc = policy.UpdatedUtc,
            });
        }
        _edits = edits;

        var own = await Api.Get<List<CategorySlaPolicy>>("api/sla/category-policies");
        if (own is not null) _categoryPolicies = own;
        _removing = null;

        var categories = await Api.Get<PagedResult<Category>>("api/categories?sort=name&pageSize=100");
        if (categories is not null)
        {
            _categories = categories.Items;
            if (_ownCategoryId == 0 && _categories.Count > 0) _ownCategoryId = _categories[0].Id;
        }
    }

    private string CategoryName(long categoryId)
    {
        foreach (var category in _categories)
        {
            if (category.Id == categoryId) return category.Name;
        }
        return $"Category #{categoryId}";
    }

    private async Task SaveOwn()
    {
        await Api.Put($"api/sla/category-policies/{_ownCategoryId}/{_ownPriority}",
            new { respondMinutes = _ownRespondMinutes, resolveMinutes = _ownResolveMinutes }, "Category numbers saved.");
        await Load();
    }

    private async Task RemoveOwn(CategorySlaPolicy own)
    {
        await Api.Delete($"api/sla/category-policies/{own.CategoryId}/{own.Priority}", "Category numbers removed.");
        await Load();
    }

    // Whether or not it worked, show the policies as they are now: a refused change should not look saved.
    private async Task Save(PolicyEdit edit)
    {
        await Api.Put($"api/sla/policies/{edit.Priority}", new { respondMinutes = edit.RespondMinutes, resolveMinutes = edit.ResolveMinutes },
            $"{edit.Priority} saved.");
        await Load();
    }
}
