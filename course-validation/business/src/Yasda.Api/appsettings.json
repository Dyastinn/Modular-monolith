{
  "ConnectionStrings": {
    "YasdaDb": "",
    "YasdaDbMigrations": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  },
  "InitialAdmin": {
    "Email": "",
    "Password": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": "",
    "RequireCertificate": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": ""
  },
  "App": {
    "PublicUrl": ""
  },
  "Mail": {
    "PollIntervalMs": 2000,
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "CookieHours": 8
