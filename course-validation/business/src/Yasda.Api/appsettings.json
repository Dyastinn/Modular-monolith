    "AuthRequestsPerMinute": 10
  },
  "Outbox": {
    "PollIntervalMs": 2000,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
