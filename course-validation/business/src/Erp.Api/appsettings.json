{
  "ConnectionStrings": {
    "ErpDb": "",
    "ErpDbMigrations": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "CookieHours": 8
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "AuthRequestsPerMinute": 10
  },
  "Outbox": {
    "PollIntervalMs": 2000,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": []
  },
  "ApiKeys": {
    "web": "",
    "mobile": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
