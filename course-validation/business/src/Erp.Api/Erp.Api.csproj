<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host: the one project that references every module and the infrastructure, and wires them together. -->
  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\Erp.Modules.Identity\Erp.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Sales\Erp.Modules.Sales\Erp.Modules.Sales.csproj" />
    <ProjectReference Include="..\Modules\Inventory\Erp.Modules.Inventory\Erp.Modules.Inventory.csproj" />
    <ProjectReference Include="..\Shared\Erp.Shared.Infrastructure\Erp.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Mediator.Abstractions" />
    <!-- The source generator writes the mediator for every module at compile time. It runs HERE, which is why
         each module grants InternalsVisibleTo("Erp.Api"): the generated code names their internal handlers. -->
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
