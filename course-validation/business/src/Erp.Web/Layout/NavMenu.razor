@* Each person sees the parts of the system their role uses. The API enforces the same rules; hiding a link is
   only a convenience. *@
<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Home</MudNavLink>

    <AuthorizeView Roles="@Sales">
        <MudNavGroup Title="Sales" Icon="@Icons.Material.Filled.PointOfSale" Expanded="true">
            <MudNavLink Href="sales-orders">Sales orders</MudNavLink>
            <MudNavLink Href="customers">Customers</MudNavLink>
            <MudNavLink Href="price-list">Price list</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@Stock">
        <MudNavGroup Title="Inventory" Icon="@Icons.Material.Filled.Inventory2" Expanded="true">
            <MudNavLink Href="items">Items and stock</MudNavLink>
            <MudNavLink Href="shipments">Shipments</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@Buying">
        <MudNavGroup Title="Purchasing" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="true">
            <MudNavLink Href="purchase-orders">Purchase orders</MudNavLink>
            <MudNavLink Href="suppliers">Suppliers</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@Billing">
        <MudNavGroup Title="Invoicing" Icon="@Icons.Material.Filled.ReceiptLong" Expanded="true">
            <MudNavLink Href="invoices">Invoices</MudNavLink>
            <MudNavLink Href="receivables-aging">Receivables aging</MudNavLink>
            <AuthorizeView Roles="@Accounting" Context="accounting">
                <MudNavLink Href="withholding-tax">Withholding tax (2307)</MudNavLink>
                <MudNavLink Href="company">Company and tax</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Admin">
        <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
            <MudNavLink Href="users">Users</MudNavLink>
            <MudNavLink Href="sign-in-log">Sign-in log</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>

@code {
    private static readonly string Sales = Join(Roles.SalesRep, Roles.SalesManager, Roles.Admin, Roles.InventoryClerk, Roles.Accountant);
    private static readonly string Stock = Join(Roles.InventoryClerk, Roles.Admin, Roles.Purchaser, Roles.SalesManager, Roles.SalesRep);
    private static readonly string Buying = Join(Roles.Purchaser, Roles.Admin, Roles.InventoryClerk, Roles.Accountant);
    private static readonly string Billing = Join(Roles.Accountant, Roles.Admin, Roles.SalesManager);
    private static readonly string Accounting = Join(Roles.Accountant, Roles.Admin);

    private static string Join(params string[] roles) => string.Join(",", roles);
}
