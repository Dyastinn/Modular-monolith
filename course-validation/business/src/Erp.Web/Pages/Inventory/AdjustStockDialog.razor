@inject ApiClient Api

@* A count correction: found, lost, damaged. Positive adds, negative removes. Every adjustment is kept with its reason. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width:380px">
            <MudText>On hand now: @Format.Qty(Item.OnHand) @Item.Unit (reserved @Format.Qty(Item.Reserved))</MudText>
            <MudNumericField @bind-Value="_change" Label="@($"Change ({Item.Unit}): + found, − lost or damaged")"
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField @bind-Value="_reason" Label="Reason" MaxLength="500" Lines="2"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            @if (_change > 0)
            {
                @* Stock found has a value too: say what it cost, or it joins at the current average. *@
                <MudNumericField T="decimal?" @bind-Value="_unitCost" Label="Cost per unit (₱)" Min="0" Format="0.00##" Clearable="true"
                                 HelperText="@CostHelp" Variant="Variant.Outlined" Margin="Margin.Normal" />
            }
            <MudText Typo="Typo.body2">After: @Format.Qty(Item.OnHand + _change) @Item.Unit</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_change == 0 || string.IsNullOrWhiteSpace(_reason) || Api.Busy)">Adjust</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public StockItem Item { get; set; } = default!;

    private decimal _change;
    private decimal? _unitCost;
    private string _reason = "";

    private string CostHelp => Item.AverageCost is { } avg
        ? $"Leave empty to use the average, {Format.Cost(avg)}."
        : "Leave empty to use the item's average cost.";

    private async Task Save()
    {
        if (await Api.Post($"api/items/{Item.Id}/adjustments", new { quantity = _change, reason = _reason, unitCost = _change > 0 ? _unitCost : null }, "Stock adjusted."))
            Dialog.Close(DialogResult.Ok(true));
    }
}
