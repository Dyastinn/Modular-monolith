@page "/shipments"
@inject ApiClient Api
@inject UserDirectory Users
@inject ListAddress View

<PageTitle>Shipments · ERP</PageTitle>

<PageHeader Title="Shipments">
    <Description>To ship an approved order, open it from <MudLink Href="sales-orders?status=Approved">Ready to ship</MudLink> and choose Ship.</Description>
</PageHeader>

<MudDataGrid T="Shipment" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Shipment" InitialDirection="@View.Initial(nameof(Shipment.Number))" />
        <PropertyColumn Property="x => x.OrderNumber" Title="Order" InitialDirection="@View.Initial(nameof(Shipment.OrderNumber))">
            <CellTemplate><MudLink Href="@($"sales-orders/{context.Item.SalesOrderId}")">@context.Item.OrderNumber</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.LineCount" Title="Lines" Sortable="false" />
        @(MoneyColumn.Of<Shipment>("Cost of goods", x => x.CostOfGoods, initial: View.Initial(nameof(Shipment.CostOfGoods))))
        <PropertyColumn Property="x => x.ShippedUtc" Title="Shipped" InitialDirection="@View.Initial(nameof(Shipment.ShippedUtc))">
            <CellTemplate>@Format.Date(context.Item.ShippedUtc)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="By"><CellTemplate>@_names.GetValueOrDefault(context.Item.ShippedBy)</CellTemplate></TemplateColumn>
    </Columns>
    <NoRecordsContent>Nothing has shipped yet.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="Shipment" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private readonly Dictionary<long, string> _names = [];

    private async Task<GridData<Shipment>> Load(GridState<Shipment> state, CancellationToken ct)
    {
        View.Save(state);
        var page = await Api.Page<Shipment>("api/shipments", state);
        foreach (var id in page.Items!.Select(s => s.ShippedBy).Distinct()) _names[id] = await Users.NameOf(id);
        return page;
    }

    // A link to this list (the menu, Back) shows it from its own address.
    protected override void OnParametersSet() => View.Check();
}
