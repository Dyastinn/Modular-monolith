@page "/sales-orders/{Id:long}"
@inject ApiClient Api
@inject ListMemory Lists
@inject UserDirectory Users
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_order?.OrderNumber ?? "Order") · ERP</PageTitle>

@if (_order is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PageHeader Title="@_order.OrderNumber" Trail="@([new BreadcrumbItem("Sales orders", Lists.Last("sales-orders")), new BreadcrumbItem(_order.OrderNumber, null, disabled: true)])">
    <Status><StatusChip Status="@_order.Status" Live="true" /></Status>
    <Actions>
        @* The API decides what's allowed; the buttons only show what could make sense for this order and this person. *@
        @if (_order.Status == "Draft")
        {
            <AuthorizeView Roles="@Sellers">
                <MudButton Href="@($"sales-orders/{Id}/edit")" Variant="Variant.Outlined">Edit</MudButton>
                @if (_order.SpecialDiscount is null && _order.Lines.Any(l => l.SpecialDiscountEligible))
                {
                    <MudButton OnClick="ApplyDiscount" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Elderly" Disabled="Api.Busy">Special discount</MudButton>
                }
                else if (_order.SpecialDiscount is not null)
                {
                    <MudButton OnClick="RemoveDiscount" Variant="Variant.Text" Disabled="Api.Busy">Remove discount</MudButton>
                }
                <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="Api.Busy">Submit</MudButton>
            </AuthorizeView>
        }
        @if (_order.Status == "PendingApproval")
        {
            <AuthorizeView Context="auth">
                @if (ApprovalText.CanGive(auth.User, _order.PendingApprovals))
                {
                    <MudButton OnClick="Reject" Variant="Variant.Outlined" Color="Color.Error" Disabled="Api.Busy">Reject</MudButton>
                    <MudButton OnClick="Approve" Variant="Variant.Filled" Color="Color.Success" Disabled="Api.Busy">@ApprovalText.ActionLabel(auth.User, _order.PendingApprovals)</MudButton>
                }
            </AuthorizeView>
        }
        @if (_order.Status is "Approved" or "PartiallyShipped")
        {
            <AuthorizeView Roles="@Shippers">
                <MudButton OnClick="Ship" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LocalShipping" Disabled="Api.Busy">Ship</MudButton>
            </AuthorizeView>
        }
        @if (_order.Status == "PartiallyShipped")
        {
            <AuthorizeView Roles="@Sellers">
                <MudButton OnClick="CloseShort" Variant="Variant.Outlined" Disabled="Api.Busy">Close short</MudButton>
            </AuthorizeView>
        }
        @if (_order.Status is "Draft" or "PendingApproval" or "Approved")
        {
            <AuthorizeView Roles="@Sellers">
                <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Error" Disabled="Api.Busy">Cancel order</MudButton>
            </AuthorizeView>
        }
        @if (_order.Status is "Shipped" or "PartiallyShipped" or "Closed")
        {
            <AuthorizeView Roles="@Billing">
                <MudButton Href="@Url.With("invoices", ("search", _order.OrderNumber))" Variant="Variant.Outlined">Invoice</MudButton>
            </AuthorizeView>
        }
    </Actions>
</PageHeader>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">@_order.CustomerName</MudText>
            <MudDataGrid T="SalesOrderLine" Items="_order.Lines"
                         Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
                <Columns>
                    <TemplateColumn Title="Item">
                        <CellTemplate>@context.Item.ItemName @(context.Item.SpecialDiscountEligible && _order.SpecialDiscount is not null ? "*" : "")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Quantity" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Qty(context.Item.Quantity) @context.Item.Unit</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Shipped" HeaderClass="money" CellClass="money" Hidden="@(!HasShipped)">
                        <CellTemplate>@Format.Qty(context.Item.ShippedQuantity)</CellTemplate>
                    </TemplateColumn>
                    @(MoneyColumn.Of<SalesOrderLine>("Unit price", x => x.UnitPrice))
                    @(MoneyColumn.Of<SalesOrderLine>("Amount", x => x.LineTotal))
                </Columns>
            </MudDataGrid>
            <Totals>
                @if (_order.SpecialDiscount is { } d)
                {
                    <TotalLine Label="Gross" Amount="_order.GrossTotal" />
                    @if (d.VatExemption > 0)
                    {
                        <TotalLine Label="Less: VAT exemption (* items)" Amount="d.VatExemption" />
                    }
                    <TotalLine Label="@($"Less: {Format.Percent(d.Rate)} {d.Program.ToLower()} discount (* items)")" Amount="d.Discount" />
                }
                <TotalLine Label="Total" Amount="_order.Total" Strong="true" />
            </Totals>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">History</MudText>
            <MudText Typo="Typo.body2">Created by @_names.Created, @Format.Date(_order.CreatedUtc)</MudText>
            @if (_order.SubmittedUtc is not null) { <MudText Typo="Typo.body2">Submitted @Format.Date(_order.SubmittedUtc)</MudText> }
            @if (_order.PendingApprovals.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">Waiting for @ApprovalText.Describe(_order.PendingApprovals).</MudAlert>
            }
            @if (_order.CreditReleasedUtc is not null)
            {
                <MudText Typo="Typo.body2">Credit released by @_names.CreditReleased, @Format.Date(_order.CreditReleasedUtc)</MudText>
            }
            @if (_order.ApprovedUtc is not null)
            {
                <MudText Typo="Typo.body2">
                    Approved @(_names.Approved is { } by ? $"by {by}" : "automatically (within the approval limit)"), @Format.Date(_order.ApprovedUtc)
                </MudText>
            }
            @if (_order.RejectionReason is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">Rejected by @_names.Rejected: @_order.RejectionReason</MudAlert>
            }
            @if (_order.ShippedUtc is not null) { <MudText Typo="Typo.body2">Shipped @Format.Date(_order.ShippedUtc)</MudText> }
        </MudPaper>
        @if (_order.SpecialDiscount is { } discount)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true">
                <MudText Typo="Typo.h6" GutterBottom="true">@discount.Program discount</MudText>
                <MudText Typo="Typo.body2">@discount.HolderName</MudText>
                <MudText Typo="Typo.body2">@discount.IdLabel @discount.IdNumber</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long Id { get; set; }

    private static readonly string Sellers = $"{Roles.SalesRep},{Roles.SalesManager},{Roles.Admin}";
    private static readonly string Shippers = $"{Roles.InventoryClerk},{Roles.Admin}";
    private static readonly string Billing = $"{Roles.Accountant},{Roles.Admin},{Roles.SalesManager}";

    private SalesOrderDetail? _order;
    private bool HasShipped => _order!.Lines.Any(l => l.ShippedQuantity > 0);
    private (string Created, string? Approved, string? Rejected, string? CreditReleased) _names = ("", null, null, null);

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        _order = await Api.Get<SalesOrderDetail>($"api/sales-orders/{Id}");
        if (_order is null) { Nav.NavigateTo(Lists.Last("sales-orders")); return; }
        _names = (await Users.NameOf(_order.CreatedBy),
                  _order.ApprovedBy is null ? null : await Users.NameOf(_order.ApprovedBy),
                  _order.RejectedBy is null ? null : await Users.NameOf(_order.RejectedBy),
                  _order.CreditReleasedBy is null ? null : await Users.NameOf(_order.CreditReleasedBy));
    }

    private async Task Act(string action, string message)
    {
        if (await Api.Post($"api/sales-orders/{Id}/{action}", success: message)) await Load();
    }

    private Task Submit() => Act("submit", "Submitted. Stock is reserved.");

    private async Task ApplyDiscount()
    {
        var dialog = await Dialogs.ShowAsync<SpecialDiscountDialog>("Special discount", new DialogParameters<SpecialDiscountDialog> { { x => x.OrderId, Id } });
        if (await dialog.Result is { Canceled: false }) await Load();
    }

    private async Task RemoveDiscount()
    {
        if (await Api.Delete($"api/sales-orders/{Id}/special-discount", "Discount removed.")) await Load();
    }
    private Task Approve() => Act("approve", "Done. The order moves on once every approval is in.");

    private async Task Reject()
    {
        if (await ReasonDialog.Ask(Dialogs, "Reject order", "Tell the sales rep why. The reserved stock is released.", "Reject") is { } reason
            && await Api.Post($"api/sales-orders/{Id}/reject", new { reason }, "Rejected."))
            await Load();
    }

    private async Task Cancel()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Cancel order", "Cancel this order? Reserved stock is released and any charge is reversed.",
            yesText: "Cancel order", cancelText: "Keep it");
        if (confirmed == true) await Act("cancel", "Cancelled.");
    }

    // Shipping can't be undone: the stock leaves and the invoice is issued. So it asks first, and asks how much.
    private async Task Ship()
    {
        var dialog = await Dialogs.ShowAsync<ShipDialog>("Ship order", new DialogParameters<ShipDialog> { { d => d.Order, _order! } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task CloseShort()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Close short",
            $"Close {_order!.OrderNumber} with what has shipped? The rest is released from stock and taken off the customer's balance. This can't be undone.",
            yesText: "Close short", cancelText: "Keep waiting");
        if (confirmed == true) await Act("close", "Closed: the rest won't ship.");
    }
}
