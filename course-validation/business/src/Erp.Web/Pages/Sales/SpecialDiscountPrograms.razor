@inject ApiClient Api

@* The discounts the business grants by law. Senior citizen and PWD come ready; others are the business's call. *@
<MudDataGrid T="SpecialDiscountProgram" Items="_programs"
             Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Code" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.IdLabel" Title="ID asked for" />
        <TemplateColumn Title="Rate" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Percent(context.Item.Rate)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="VAT-exempt"><CellTemplate>@(context.Item.VatExempt ? "Yes" : "No")</CellTemplate></TemplateColumn>
        <TemplateColumn Title="Offered"><CellTemplate>@(context.Item.IsActive ? "Yes" : "No")</CellTemplate></TemplateColumn>
        <TemplateColumn Title="">
            <CellTemplate>
                <AuthorizeView Roles="@Managers" Context="auth">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Start(context.Item)" aria-label="Edit" />
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No programs yet.</NoRecordsContent>
</MudDataGrid>

<AuthorizeView Roles="@Managers">
    <MudPaper Class="pa-4 ma-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@(_editing is null ? "New program" : $"Edit {_editing.Name}")</MudText>
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Breakpoint="Breakpoint.Xs">
            <MudTextField @bind-Value="_code" Label="Code" MaxLength="20" Disabled="_editing is not null" Style="max-width:100px"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField @bind-Value="_name" Label="Name" MaxLength="50"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField @bind-Value="_idLabel" Label="ID asked for" MaxLength="50"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudNumericField @bind-Value="_percent" Label="Rate (%)" Min="0.01m" Max="99.99m" Style="max-width:110px"
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudSwitch @bind-Value="_vatExempt" Label="VAT-exempt" Color="Color.Primary" />
            <MudSwitch @bind-Value="_active" Label="Offered" Color="Color.Primary" />
            <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@((string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_idLabel)) || Api.Busy)">Save</MudButton>
            @if (_editing is not null) { <MudButton OnClick="() => Start(null)">Cancel</MudButton> }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">
            A change applies to orders discounted from now on. Confirm rates and VAT treatment with the business's tax adviser.
        </MudText>
    </MudPaper>
</AuthorizeView>

@code {
    private static readonly string Managers = $"{Roles.SalesManager},{Roles.Admin}";
    private List<SpecialDiscountProgram> _programs = [];
    private SpecialDiscountProgram? _editing;
    private string _code = "", _name = "", _idLabel = "";
    private decimal _percent = 20;
    private bool _vatExempt = true, _active = true;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() =>
        _programs = await Api.Get<List<SpecialDiscountProgram>>("api/special-discount-programs?includeInactive=true") ?? [];

    private void Start(SpecialDiscountProgram? p)
    {
        _editing = p;
        (_code, _name, _idLabel, _percent, _vatExempt, _active) = p is null
            ? ("", "", "", 20m, true, true)
            : (p.Code, p.Name, p.IdLabel, p.Rate * 100, p.VatExempt, p.IsActive);
    }

    private async Task Save()
    {
        var body = new { name = _name, idLabel = _idLabel, rate = _percent / 100, vatExempt = _vatExempt, isActive = _active };
        if (!await Api.Put($"api/special-discount-programs/{Uri.EscapeDataString(_code)}", body, "Program saved.")) return;
        Start(null);
        await Load();
    }
}
