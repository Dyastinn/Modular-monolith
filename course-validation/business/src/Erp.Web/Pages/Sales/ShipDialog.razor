@inject ApiClient Api

@* What goes out now. Everything still to ship is filled in; lower a line to ship part of it, and the rest stays
   reserved for later. Shipping can't be undone: the stock leaves and an invoice is issued for what ships. *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">
            Ship @Order.OrderNumber now? The stock leaves the warehouse and an invoice is issued for what ships. This can't be undone.
        </MudText>
        <MudDataGrid T="Entry" Items="_lines"
                     Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="Item"><CellTemplate>@context.Item.Line.ItemName</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Still to ship" HeaderClass="money" CellClass="money">
                    <CellTemplate>@Format.Qty(context.Item.Line.Outstanding) @context.Item.Line.Unit</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Ship now">
                    <CellTemplate>
                        <MudNumericField T="decimal" @bind-Value="context.Item.Quantity" Min="0" Max="context.Item.Line.Outstanding"
                                         Disabled="WholeOnly" Style="max-width:140px" Label="@($"Ship now: {context.Item.Line.ItemName}")"
                                         Variant="Variant.Outlined" Margin="Margin.Normal" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
        @if (WholeOnly)
        {
            <MudText Typo="Typo.body2" Class="mt-2">This order has a @Order.SpecialDiscount!.Program.ToLower() discount, so it ships in one go.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Not yet</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_lines.Any(l => l.Quantity > 0) || Api.Busy)">Ship</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public SalesOrderDetail Order { get; set; } = default!;

    private bool WholeOnly => Order.SpecialDiscount is not null;

    private sealed class Entry(SalesOrderLine line)
    {
        public SalesOrderLine Line { get; } = line;
        public decimal Quantity { get; set; } = line.Outstanding;
    }

    private List<Entry> _lines = [];

    protected override void OnInitialized() => _lines = Order.Lines.Where(l => l.Outstanding > 0).Select(l => new Entry(l)).ToList();

    private async Task Save()
    {
        var lines = _lines.Where(l => l.Quantity > 0).Select(l => new { itemId = l.Line.ItemId, quantity = l.Quantity }).ToList();
        if (await Api.Create("api/shipments", new { salesOrderId = Order.Id, lines }, "Shipped. The invoice is being issued.") is not null)
            Dialog.Close(DialogResult.Ok(true));
    }
}
