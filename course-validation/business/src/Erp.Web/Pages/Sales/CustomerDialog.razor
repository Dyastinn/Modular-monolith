@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width:420px">
            <MudTextField @bind-Value="_name" Label="Name" Required="true" MaxLength="200"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField @bind-Value="_tin" Label="TIN" MaxLength="20" HelperText="Printed on invoices"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField @bind-Value="_address" Label="Address" Lines="2" MaxLength="500"
                          Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudNumericField @bind-Value="_creditLimit" Label="Credit limit (₱)" Min="0" Format="N2"
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudNumericField @bind-Value="_terms" Label="Payment terms (days)" Min="0" Max="365"
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudNumericField T="decimal?" @bind-Value="_approvalThreshold" Label="Approval limit (₱)" Min="0" Format="N2" Clearable="true"
                             HelperText="@ApprovalHelp" Variant="Variant.Outlined" Margin="Margin.Normal" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(_name) || Api.Busy)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Customer? Customer { get; set; }

    private string _name = "";
    private string? _tin, _address;
    private decimal _creditLimit;
    private int _terms = 30;
    private decimal? _approvalThreshold;
    private ApprovalLimit? _company;

    // Empty uses the company's limit; 0 sends every order to a manager.
    private string ApprovalHelp => _company is null
        ? "Leave empty to use the company's limit"
        : $"Leave empty to use the company's {Format.Peso(_company.ApprovalThreshold)}. Orders above it wait for a sales manager; 0 means every order.";

    protected override async Task OnInitializedAsync()
    {
        if (Customer is { } c)
            (_name, _tin, _address, _creditLimit, _terms, _approvalThreshold) =
                (c.Name, c.Tin, c.Address, c.CreditLimit, c.PaymentTermsDays, c.ApprovalThreshold);
        _company = await Api.Get<ApprovalLimit>("api/sales-settings/approval-limit");
    }

    private async Task Save()
    {
        var body = new { name = _name, tin = _tin, address = _address, creditLimit = _creditLimit, paymentTermsDays = _terms,
            approvalThreshold = _approvalThreshold };
        var saved = Customer is null
            ? await Api.Create("api/customers", body, "Customer added.") is not null
            : await Api.Put($"api/customers/{Customer.Id}", body, "Customer saved.");
        if (saved) Dialog.Close(DialogResult.Ok(true));
    }
}
