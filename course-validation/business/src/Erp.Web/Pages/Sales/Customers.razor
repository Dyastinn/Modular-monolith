@page "/customers"
@inject ApiClient Api
@inject ListAddress View
@inject IDialogService Dialogs

<PageTitle>Customers · ERP</PageTitle>

<PageHeader Title="Customers">
    <Actions>
        <AuthorizeView Roles="@Managers">
            <MudButton OnClick="() => Edit(null)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New customer</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="Name or TIN" DebounceInterval="400" Clearable="true"
              Variant="Variant.Outlined" Margin="Margin.Normal"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

<MudDataGrid T="Customer" @ref="_table" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" InitialDirection="@View.Initial(nameof(Customer.Name))">
            <CellTemplate>
                @context.Item.Name
                @if (context.Item.IsBlocked) { <MudChip T="string" Color="Color.Error" Size="Size.Small">Blocked</MudChip> }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Tin" Title="TIN" Sortable="false" />
        @(MoneyColumn.Of<Customer>("Credit limit", x => x.CreditLimit, initial: View.Initial(nameof(Customer.CreditLimit))))
        @(MoneyColumn.Of<Customer>("Owes", x => x.OutstandingBalance, initial: View.Initial(nameof(Customer.OutstandingBalance))))
        @(MoneyColumn.Of<Customer>("Awaiting approval", x => x.PendingTotal, initial: View.Initial(nameof(Customer.PendingTotal))))
        @(MoneyColumn.Of<Customer>("Available", x => x.AvailableCredit, initial: View.Initial(nameof(Customer.AvailableCredit))))
        <PropertyColumn Property="x => x.PaymentTermsDays" Title="Terms" InitialDirection="@View.Initial(nameof(Customer.PaymentTermsDays))">
            <CellTemplate>@context.Item.PaymentTermsDays days</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Approval limit">
            <CellTemplate>@(context.Item.ApprovalThreshold is { } t ? Format.Peso(t) : "Company's")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="">
            <CellTemplate>
                <AuthorizeView Roles="@Managers" Context="auth">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Actions">
                        <MudMenuItem OnClick="() => Edit(context.Item)">Edit</MudMenuItem>
                        <MudMenuItem OnClick="() => ToggleBlock(context.Item)">@(context.Item.IsBlocked ? "Unblock" : "Block")</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No customers match.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="Customer" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private static readonly string Managers = $"{Roles.SalesManager},{Roles.Admin}";
    private MudDataGrid<Customer> _table = default!;

    private Task<GridData<Customer>> Load(GridState<Customer> state, CancellationToken ct)
    {
        View.Save(state, ("search", Search));
        return Api.Page<Customer>(Url.With("api/customers", ("search", Search)), state);
    }

    // A link to this list with other filters (the menu, a home tile, Back) shows them.
    protected override void OnParametersSet() => View.Check();

    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }

    private async Task Edit(Customer? customer)
    {
        var parameters = new DialogParameters<CustomerDialog> { { d => d.Customer, customer } };
        var dialog = await Dialogs.ShowAsync<CustomerDialog>(customer is null ? "New customer" : "Edit customer", parameters);
        if ((await dialog.Result) is { Canceled: false }) await _table.ReloadServerData();
    }

    private async Task ToggleBlock(Customer customer)
    {
        var action = customer.IsBlocked ? "unblock" : "block";
        if (await Api.Post($"api/customers/{customer.Id}/{action}", success: customer.IsBlocked ? "Unblocked." : "Blocked: no new orders."))
            await _table.ReloadServerData();
    }
}
