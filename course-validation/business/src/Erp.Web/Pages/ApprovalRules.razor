@page "/approval-rules"
@attribute [Authorize(Roles = Roles.Admin)]
@inject ApiClient Api
@inject IDialogService Dialogs
@inject UserDirectory Users

<PageTitle>Approval rules · ERP</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Unsaved" />

<PageHeader Title="Approval rules">
    <Description>
        How large an order may be before a second person must look at it. A change applies to orders submitted from now on.
        Orders over a customer's credit limit always wait for an accountant, whatever their size.
    </Description>
</PageHeader>

@if (_sales is null || _purchasing is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Sales orders</MudText>
            <MudNumericField @bind-Value="_salesLimit" Label="Approval limit (₱)" Min="0" Format="N2"
                             HelperText="Above this, a sales manager approves. A customer can have its own limit, set on the customer."
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Changed(_sales, _salesBy)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Purchase orders</MudText>
            <MudNumericField @bind-Value="_purchasingLimit" Label="Approval limit (₱)" Min="0" Format="N2"
                             HelperText="Above this, an admin approves. ₱0: an admin approves every purchase order."
                             Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Changed(_purchasing, _purchasingBy)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudStack Row="true" Class="mt-4">
    <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Unsaved || Api.Busy)">Save</MudButton>
</MudStack>

@code {
    private ApprovalLimit? _sales, _purchasing;
    private string? _salesBy, _purchasingBy;
    private decimal _salesLimit, _purchasingLimit;

    private bool Unsaved => _sales is not null && (_salesLimit != _sales.ApprovalThreshold || _purchasingLimit != _purchasing!.ApprovalThreshold);
    private Task ConfirmLeave(LocationChangingContext context) => UnsavedChanges.ConfirmLeave(Dialogs, context, Unsaved);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _sales = await Api.Get<ApprovalLimit>("api/sales-settings/approval-limit");
        _purchasing = await Api.Get<ApprovalLimit>("api/purchasing-settings/approval-limit");
        if (_sales is null || _purchasing is null) return;
        (_salesLimit, _purchasingLimit) = (_sales.ApprovalThreshold, _purchasing.ApprovalThreshold);
        _salesBy = _sales.UpdatedBy is null ? null : await Users.NameOf(_sales.UpdatedBy);
        _purchasingBy = _purchasing.UpdatedBy is null ? null : await Users.NameOf(_purchasing.UpdatedBy);
    }

    private static string Changed(ApprovalLimit limit, string? by) =>
        limit.UpdatedUtc is null ? "Not changed since installation." : $"Last changed by {by}, {Format.Date(limit.UpdatedUtc)}.";

    // Two modules, two saves: each owns its own limit.
    private async Task Save()
    {
        var ok = true;
        if (_salesLimit != _sales!.ApprovalThreshold)
            ok &= await Api.Put("api/sales-settings/approval-limit", new { approvalThreshold = _salesLimit });
        if (_purchasingLimit != _purchasing!.ApprovalThreshold)
            ok &= await Api.Put("api/purchasing-settings/approval-limit", new { approvalThreshold = _purchasingLimit });
        if (ok) Snackbar("Saved.");
        await Load();
    }

    [Inject] private ISnackbar Snack { get; set; } = default!;
    private void Snackbar(string message) => Snack.Add(message, Severity.Success);
}
