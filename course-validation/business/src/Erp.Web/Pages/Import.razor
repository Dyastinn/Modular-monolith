@page "/import"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Accountant}")]

<PageTitle>Import data · ERP</PageTitle>

<PageHeader Title="Import data">
    <Description>
        Going live from spreadsheets. Work left to right: customers and items first, then prices and what customers still
        owe. Each file is checked row by row before anything is saved, and then saved all at once.
    </Description>
</PageHeader>

@* Tabs join the strip in the order they first render, so the role is known before any is drawn. *@
@if (_isAdmin is not { } isAdmin)
{
    return;
}
<MudTabs Outlined="true" Rounded="true" TabPanelsClass="pa-4">
    @if (isAdmin)
    {
        <MudTabPanel Text="1. Customers">
            <ImportPanel Url="api/customers/import" FileName="customers" Columns="CustomerColumns" Convert="Customer">
                <Help>
                    <MudText Typo="Typo.body2">
                        One customer per row. credit_limit and payment_terms_days are required;
                        leave approval_limit empty to use the company's. A customer already on the system is refused, so a file can be run again safely.
                    </MudText>
                </Help>
            </ImportPanel>
        </MudTabPanel>
        <MudTabPanel Text="2. Items and opening stock">
            <ImportPanel Url="api/items/import" FileName="items" Columns="ItemColumns" Convert="Item">
                <Help>
                    <MudText Typo="Typo.body2">
                        One item per row. quantity and unit_cost are the stock counted on go-live day and what each unit cost; it
                        becomes the item's average cost. allows_fractions is yes for items sold by weight or length.
                    </MudText>
                </Help>
            </ImportPanel>
        </MudTabPanel>
        <MudTabPanel Text="3. Prices">
            <ImportPanel Url="api/price-list/import" FileName="prices" Columns="PriceColumns" Convert="Price">
                <Help>
                    <MudText Typo="Typo.body2">
                        One item per row, by SKU, with its category by name. tax_type is Vatable, ZeroRated or VatExempt (empty: Vatable).
                        Import the items first; a new item reaches the price list a few seconds later.
                    </MudText>
                </Help>
            </ImportPanel>
        </MudTabPanel>
    }
    <MudTabPanel Text="4. Opening balances">
        <ImportPanel Url="api/opening-balances/import" FileName="opening-balances" Columns="BalanceColumns" Convert="Balance">
            <Help>
                <MudText Typo="Typo.body2">
                    One unpaid old invoice per row: the customer's name exactly as on the Customers page, the old invoice's number
                    and date (YYYY-MM-DD), and what is still owed on it. Each becomes an OB- document: it shows in receivables aging,
                    takes payments and counts against credit, but it isn't a sale and is never printed as an invoice.
                </MudText>
            </Help>
        </ImportPanel>
    </MudTabPanel>
</MudTabs>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;
    private bool? _isAdmin;

    protected override async Task OnInitializedAsync() => _isAdmin = (await Auth).User.IsInRole(Roles.Admin);

    private static readonly string[] CustomerColumns = ["name", "tin", "address", "credit_limit", "payment_terms_days", "approval_limit"];
    private static readonly string[] ItemColumns = ["sku", "name", "unit", "allows_fractions", "quantity", "unit_cost"];
    private static readonly string[] PriceColumns = ["sku", "unit_price", "category", "for_sale", "tax_type", "sc_pwd_eligible"];
    private static readonly string[] BalanceColumns = ["customer", "reference", "invoice_date", "due_date", "amount"];

    // Each turns one row of the file into what the API takes, or says what's wrong in words a person can fix.
    private static (object?, string?) Customer(Dictionary<string, string> r)
    {
        if (!Csv.TryDecimal(r.GetValueOrDefault("credit_limit", ""), out var limit)) return (null, "credit_limit is not a number.");
        if (!int.TryParse(r.GetValueOrDefault("payment_terms_days", ""), out var terms)) return (null, "payment_terms_days is not a whole number.");
        decimal? approval = null;
        if (r.GetValueOrDefault("approval_limit", "") is { Length: > 0 } a)
        {
            if (!Csv.TryDecimal(a, out var value)) return (null, "approval_limit is not a number.");
            approval = value;
        }
        return (new { name = r.GetValueOrDefault("name", ""), tin = Blank(r, "tin"), address = Blank(r, "address"),
            creditLimit = limit, paymentTermsDays = terms, approvalThreshold = approval }, null);
    }

    private static (object?, string?) Item(Dictionary<string, string> r)
    {
        if (!Csv.TryBool(r.GetValueOrDefault("allows_fractions", ""), false, out var fractions)) return (null, "allows_fractions must be yes or no.");
        var quantity = 0m; var cost = 0m;
        if (r.GetValueOrDefault("quantity", "") is { Length: > 0 } q && !Csv.TryDecimal(q, out quantity)) return (null, "quantity is not a number.");
        if (r.GetValueOrDefault("unit_cost", "") is { Length: > 0 } c && !Csv.TryDecimal(c, out cost)) return (null, "unit_cost is not a number.");
        return (new { sku = r.GetValueOrDefault("sku", ""), name = r.GetValueOrDefault("name", ""), unit = r.GetValueOrDefault("unit", ""),
            allowsFractions = fractions, quantity, unitCost = cost }, null);
    }

    private static (object?, string?) Price(Dictionary<string, string> r)
    {
        if (!Csv.TryDecimal(r.GetValueOrDefault("unit_price", ""), out var price)) return (null, "unit_price is not a number.");
        if (!Csv.TryBool(r.GetValueOrDefault("for_sale", ""), true, out var forSale)) return (null, "for_sale must be yes or no.");
        if (!Csv.TryBool(r.GetValueOrDefault("sc_pwd_eligible", ""), false, out var eligible)) return (null, "sc_pwd_eligible must be yes or no.");
        var tax = r.GetValueOrDefault("tax_type", "") is { Length: > 0 } t ? t : "Vatable";
        if (tax is not ("Vatable" or "ZeroRated" or "VatExempt")) return (null, "tax_type must be Vatable, ZeroRated or VatExempt.");
        return (new { sku = r.GetValueOrDefault("sku", ""), unitPrice = price, category = r.GetValueOrDefault("category", ""),
            isForSale = forSale, taxType = tax, specialDiscountEligible = eligible }, null);
    }

    private static (object?, string?) Balance(Dictionary<string, string> r)
    {
        if (!Csv.TryDate(r.GetValueOrDefault("invoice_date", ""), out var date)) return (null, "invoice_date is not a date like 2026-10-31.");
        DateOnly? due = null;
        if (r.GetValueOrDefault("due_date", "") is { Length: > 0 } d)
        {
            if (!Csv.TryDate(d, out var parsed)) return (null, "due_date is not a date like 2026-11-30.");
            due = parsed;
        }
        if (!Csv.TryDecimal(r.GetValueOrDefault("amount", ""), out var amount)) return (null, "amount is not a number.");
        return (new { customer = r.GetValueOrDefault("customer", ""), reference = r.GetValueOrDefault("reference", ""),
            invoiceDate = date, dueDate = due, amount }, null);
    }

    private static string? Blank(Dictionary<string, string> r, string column) => r.GetValueOrDefault(column, "") is { Length: > 0 } v ? v : null;
}
