@page "/approvals"
@attribute [Authorize(Roles = $"{Roles.SalesManager},{Roles.Accountant},{Roles.Admin}")]
@inject ApiClient Api
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>Awaiting my approval · ERP</PageTitle>

@* One queue for everything waiting on this person, oldest first. Each module decides what's theirs to approve
   (awaitingMe=true); this page only puts the two lists side by side. *@
<PageHeader Title="Awaiting my approval">
    <Description>Orders that can't move until you say yes or no. Your own orders are never here: someone else approves them.</Description>
</PageHeader>

<MudText Typo="Typo.h6" Class="mb-2">Sales orders</MudText>
<MudDataGrid T="SalesOrderSummary" @ref="_orders" ServerData="LoadOrders"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
             RowsPerPage="ListAddress.DefaultPageSize" RowClick="OpenOrder" RowStyle="cursor:pointer">
    <Columns>
        <PropertyColumn Property="x => x.OrderNumber" Title="Order" />
        <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
        <TemplateColumn Title="Waiting for">
            <CellTemplate>
                @foreach (var need in context.Item.PendingApprovals)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@ApprovalText.Label(need)</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        @(MoneyColumn.Of<SalesOrderSummary>("Total", x => x.Total))
        <PropertyColumn Property="x => x.SubmittedUtc" Title="Submitted" InitialDirection="SortDirection.Ascending">
            <CellTemplate>@Format.Date(context.Item.SubmittedUtc)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="">
            <CellTemplate>
                <AuthorizeView Context="auth">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Actions for {context.Item.OrderNumber}")">
                        <MudMenuItem OnClick="() => ApproveOrder(context.Item)">@ApprovalText.ActionLabel(auth.User, context.Item.PendingApprovals)</MudMenuItem>
                        <MudMenuItem OnClick="() => RejectOrder(context.Item)">Reject</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No sales orders are waiting for you.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="SalesOrderSummary" /></PagerContent>
</MudDataGrid>

<AuthorizeView Roles="@Roles.Admin" Context="admin">
    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Purchase orders</MudText>
    <MudDataGrid T="PurchaseOrderSummary" @ref="_purchases" ServerData="LoadPurchases"
                 Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
                 RowsPerPage="ListAddress.DefaultPageSize" RowClick="OpenPurchase" RowStyle="cursor:pointer">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="PO" />
            <PropertyColumn Property="x => x.SupplierName" Title="Supplier" />
            @(MoneyColumn.Of<PurchaseOrderSummary>("Total", x => x.Total))
            <PropertyColumn Property="x => x.SubmittedUtc" Title="Submitted" InitialDirection="SortDirection.Ascending">
                <CellTemplate>@Format.Date(context.Item.SubmittedUtc)</CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Actions for {context.Item.Number}")">
                        <MudMenuItem OnClick="() => ApprovePurchase(context.Item)">Approve</MudMenuItem>
                        <MudMenuItem OnClick="() => RejectPurchase(context.Item)">Send back</MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>No purchase orders are waiting for you.</NoRecordsContent>
        <PagerContent><MudDataGridPager T="PurchaseOrderSummary" /></PagerContent>
    </MudDataGrid>
</AuthorizeView>

@code {
    private MudDataGrid<SalesOrderSummary> _orders = default!;
    private MudDataGrid<PurchaseOrderSummary>? _purchases;

    private void OpenOrder(DataGridRowClickEventArgs<SalesOrderSummary> row) => Nav.NavigateTo($"sales-orders/{row.Item.Id}");
    private void OpenPurchase(DataGridRowClickEventArgs<PurchaseOrderSummary> row) => Nav.NavigateTo($"purchase-orders/{row.Item.Id}");

    private Task<GridData<SalesOrderSummary>> LoadOrders(GridState<SalesOrderSummary> state, CancellationToken ct) =>
        Api.Page<SalesOrderSummary>("api/sales-orders?awaitingMe=true", state);

    private Task<GridData<PurchaseOrderSummary>> LoadPurchases(GridState<PurchaseOrderSummary> state, CancellationToken ct) =>
        Api.Page<PurchaseOrderSummary>("api/purchase-orders?awaitingMe=true", state);

    private async Task ApproveOrder(SalesOrderSummary order)
    {
        if (await Api.Post($"api/sales-orders/{order.Id}/approve", success: $"{order.OrderNumber}: done."))
            await _orders.ReloadServerData();
    }

    private async Task RejectOrder(SalesOrderSummary order)
    {
        if (await ReasonDialog.Ask(Dialogs, $"Reject {order.OrderNumber}", "Tell the sales rep why. The reserved stock is released.", "Reject") is { } reason
            && await Api.Post($"api/sales-orders/{order.Id}/reject", new { reason }, $"{order.OrderNumber} rejected."))
            await _orders.ReloadServerData();
    }

    private async Task ApprovePurchase(PurchaseOrderSummary po)
    {
        if (await Api.Post($"api/purchase-orders/{po.Id}/approve", success: $"{po.Number} approved."))
            await _purchases!.ReloadServerData();
    }

    private async Task RejectPurchase(PurchaseOrderSummary po)
    {
        if (await ReasonDialog.Ask(Dialogs, $"Send back {po.Number}", "Tell the buyer what to change. It returns to them as a draft.", "Send back") is { } reason
            && await Api.Post($"api/purchase-orders/{po.Id}/reject", new { reason }, $"{po.Number} sent back."))
            await _purchases!.ReloadServerData();
    }
}
