@page "/purchase-orders"
@inject ApiClient Api
@inject ListAddress View
@inject NavigationManager Nav

<PageTitle>Purchase orders · ERP</PageTitle>

<PageHeader Title="Purchase orders">
    <Actions>
        <AuthorizeView Roles="@Buyers">
            <MudButton Href="purchase-orders/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New purchase order</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudStack Row="true" Spacing="4" Class="mb-4" Breakpoint="Breakpoint.Xs">
    <MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="PO number or supplier" DebounceInterval="400" Clearable="true"
                  Variant="Variant.Outlined" Margin="Margin.Normal" />
    <MudSelect T="string" Value="Status" ValueChanged="OnStatus" Label="Status" Clearable="true" Style="max-width:240px"
               Variant="Variant.Outlined" Margin="Margin.Normal">
        @foreach (var s in Statuses)
        {
            <MudSelectItem Value="s">@Format.Words(s)</MudSelectItem>
        }
    </MudSelect>
</MudStack>

<MudDataGrid T="PurchaseOrderSummary" @ref="_table" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize" RowClick="Open" RowStyle="cursor:pointer">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="PO" />
        <PropertyColumn Property="x => x.SupplierName" Title="Supplier" />
        <TemplateColumn Title="Status"><CellTemplate><StatusChip Status="@context.Item.Status" /></CellTemplate></TemplateColumn>
        <MoneyColumn Title="Total" Amount="x => x.Total" />
        <TemplateColumn Title="Expected"><CellTemplate>@(context.Item.ExpectedDate is { } d ? Format.Date(d) : "")</CellTemplate></TemplateColumn>
    </Columns>
    <NoRecordsContent>No purchase orders match.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="PurchaseOrderSummary" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private static readonly string[] Statuses = ["Draft", "Approved", "Sent", "PartiallyReceived", "Received", "Closed", "Cancelled"];
    private static readonly string Buyers = $"{Roles.Purchaser},{Roles.Admin}";
    private MudDataGrid<PurchaseOrderSummary> _table = default!;

    private Task<GridData<PurchaseOrderSummary>> Load(GridState<PurchaseOrderSummary> state, CancellationToken ct)
    {
        View.Save(state, ("status", Status), ("search", Search));
        return Api.Page<PurchaseOrderSummary>(Url.With("api/purchase-orders", ("status", Status), ("search", Search)), state);
    }

    // A link to this list with other filters (the menu, a home tile, Back) shows them.
    protected override void OnParametersSet() => View.Check();

    private void Open(DataGridRowClickEventArgs<PurchaseOrderSummary> row) => Nav.NavigateTo($"purchase-orders/{row.Item.Id}");
    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }
    private Task OnStatus(string? status) { Status = status; return _table.FirstPage(); }
}
