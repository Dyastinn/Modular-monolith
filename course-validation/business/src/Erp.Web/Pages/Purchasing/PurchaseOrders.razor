@page "/purchase-orders"
@inject ApiClient Api
@inject ListAddress View
@inject NavigationManager Nav

<PageTitle>Purchase orders · ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Purchase orders</MudText>
    <MudSpacer />
    <AuthorizeView Roles="@Buyers">
        <MudButton Href="purchase-orders/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New purchase order</MudButton>
    </AuthorizeView>
</MudStack>

<MudStack Row="true" Spacing="4" Class="mb-4" Breakpoint="Breakpoint.Xs">
    <AppTextField T="string" Value="Search" ValueChanged="OnSearch" Label="PO number or supplier" DebounceInterval="400" Clearable="true" />
    <AppSelect T="string" Value="Status" ValueChanged="OnStatus" Label="Status" Clearable="true" Style="max-width:240px">
        @foreach (var s in Statuses)
        {
            <MudSelectItem Value="s">@Format.Words(s)</MudSelectItem>
        }
    </AppSelect>
</MudStack>

<AppTable T="PurchaseOrderSummary" @ref="_table" @key="View.Version" ServerData="Load"
          CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize" OnRowClick="Open" RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh>PO</MudTh><MudTh>Supplier</MudTh><MudTh>Status</MudTh><MudTh Class="money">Total</MudTh><MudTh>Expected</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="PO">@context.Number</MudTd>
        <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
        <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
        <MudTd DataLabel="Total" Class="money">@Format.Peso(context.Total)</MudTd>
        <MudTd DataLabel="Expected">@(context.ExpectedDate is { } d ? Format.Date(d) : "")</MudTd>
    </RowTemplate>
    <NoRecordsContent>No purchase orders match.</NoRecordsContent>
    <PagerContent><MudTablePager /></PagerContent>
</AppTable>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private static readonly string[] Statuses = ["Draft", "Approved", "Sent", "PartiallyReceived", "Received", "Closed", "Cancelled"];
    private static readonly string Buyers = $"{Roles.Purchaser},{Roles.Admin}";
    private AppTable<PurchaseOrderSummary> _table = default!;

    private Task<TableData<PurchaseOrderSummary>> Load(TableState state, CancellationToken ct)
    {
        View.Save(state, ("status", Status), ("search", Search));
        return Api.Page<PurchaseOrderSummary>(Url.With("api/purchase-orders", ("status", Status), ("search", Search)), state);
    }

    // A link to this list with other filters (the menu, a home tile, Back) shows them.
    protected override void OnParametersSet() => View.Check();

    private void Open(TableRowClickEventArgs<PurchaseOrderSummary> row) => Nav.NavigateTo($"purchase-orders/{row.Item!.Id}");
    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }
    private Task OnStatus(string? status) { Status = status; return _table.FirstPage(); }
}
