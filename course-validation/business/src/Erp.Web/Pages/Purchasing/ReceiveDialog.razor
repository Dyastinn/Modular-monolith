@inject ApiClient Api

@* Count what actually arrived. Partial deliveries are normal: the order stays open for the rest. *@
<MudDialog>
    <DialogContent>
        <MudDataGrid T="Entry" Items="_lines"
                     Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="Item"><CellTemplate>@context.Item.Line.Sku · @context.Item.Line.ItemName</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Still to come" HeaderClass="money" CellClass="money">
                    <CellTemplate>@Format.Qty(context.Item.Line.Outstanding) @context.Item.Line.Unit</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Arrived now">
                    <CellTemplate>
                        <MudNumericField T="decimal" @bind-Value="context.Item.Arrived" Min="0" Max="context.Item.Line.Outstanding" Style="max-width:140px"
                                         Variant="Variant.Outlined" Margin="Margin.Normal" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_lines.Any(l => l.Arrived > 0) || Api.Busy)">Put into stock</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PurchaseOrderDetail Order { get; set; } = default!;

    private sealed class Entry(PurchaseOrderLine line)
    {
        public PurchaseOrderLine Line { get; } = line;
        public decimal Arrived { get; set; } = line.Outstanding;
    }

    private List<Entry> _lines = [];

    protected override void OnInitialized() => _lines = Order.Lines.Where(l => l.Outstanding > 0).Select(l => new Entry(l)).ToList();

    private async Task Save()
    {
        var lines = _lines.Where(l => l.Arrived > 0).Select(l => new { lineId = l.Line.Id, quantity = l.Arrived });
        if (await Api.Post($"api/purchase-orders/{Order.Id}/receipts", new { lines }, "Received. Stock is updated."))
            Dialog.Close(DialogResult.Ok(true));
    }
}
