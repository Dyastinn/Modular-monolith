@page "/suppliers"
@inject ApiClient Api
@inject ListAddress View
@inject IDialogService Dialogs

<PageTitle>Suppliers · ERP</PageTitle>

<PageHeader Title="Suppliers">
    <Actions>
        <AuthorizeView Roles="@Buyers">
            <MudButton OnClick="() => Edit(null)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New supplier</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="Name or TIN" DebounceInterval="400" Clearable="true" Class="mb-4"
              Variant="Variant.Outlined" Margin="Margin.Normal" />

<MudDataGrid T="Supplier" @ref="_table" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize">
    <Columns>
        <TemplateColumn Title="Name"><CellTemplate>@context.Item.Name @if (!context.Item.IsActive) { <MudChip T="string" Size="Size.Small">Inactive</MudChip> }</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.Tin" Title="TIN" />
        <PropertyColumn Property="x => x.Email" Title="Email" />
        <PropertyColumn Property="x => x.Phone" Title="Phone" />
        <TemplateColumn Title="Terms"><CellTemplate>@context.Item.PaymentTermsDays days</CellTemplate></TemplateColumn>
        <TemplateColumn Title="">
            <CellTemplate>
                <AuthorizeView Roles="@Buyers" Context="auth">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context.Item)" aria-label="Edit" />
                    <MudButton Size="Size.Small" OnClick="() => Toggle(context.Item)">@(context.Item.IsActive ? "Deactivate" : "Activate")</MudButton>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>No suppliers match.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="Supplier" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private static readonly string Buyers = $"{Roles.Purchaser},{Roles.Admin}";
    private MudDataGrid<Supplier> _table = default!;

    private Task<GridData<Supplier>> Load(GridState<Supplier> state, CancellationToken ct)
    {
        View.Save(state, ("search", Search));
        return Api.Page<Supplier>(Url.With("api/suppliers", ("search", Search)), state);
    }

    // A link to this list with other filters (the menu, a home tile, Back) shows them.
    protected override void OnParametersSet() => View.Check();

    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }

    private async Task Edit(Supplier? supplier)
    {
        var dialog = await Dialogs.ShowAsync<SupplierDialog>(supplier is null ? "New supplier" : "Edit supplier",
            new DialogParameters<SupplierDialog> { { d => d.Supplier, supplier } });
        if ((await dialog.Result) is { Canceled: false }) await _table.ReloadServerData();
    }

    private async Task Toggle(Supplier supplier)
    {
        if (await Api.Post($"api/suppliers/{supplier.Id}/{(supplier.IsActive ? "deactivate" : "activate")}", success: "Saved."))
            await _table.ReloadServerData();
    }
}
