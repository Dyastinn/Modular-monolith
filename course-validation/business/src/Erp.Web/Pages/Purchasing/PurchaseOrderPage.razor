@page "/purchase-orders/{Id:long}"
@inject ApiClient Api
@inject ListMemory Lists
@inject UserDirectory Users
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_po?.Number ?? "Purchase order") · ERP</PageTitle>

@if (_po is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PageHeader Title="@_po.Number" Trail="@([new BreadcrumbItem("Purchase orders", Lists.Last("purchase-orders")), new BreadcrumbItem(_po.Number, null, disabled: true)])">
    <Status><StatusChip Status="@_po.Status" Live="true" /></Status>
    <Actions>
        @if (_po.Status == "Draft")
        {
            <AuthorizeView Roles="@Buyers">
                <MudButton Href="@($"purchase-orders/{Id}/edit")" Variant="Variant.Outlined">Edit</MudButton>
                <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="Api.Busy">Submit</MudButton>
            </AuthorizeView>
        }
        @if (_po.Status == "PendingApproval")
        {
            <AuthorizeView Roles="@Roles.Admin">
                <MudButton OnClick="Reject" Variant="Variant.Outlined" Color="Color.Error" Disabled="Api.Busy">Send back</MudButton>
                <MudButton OnClick="@(() => Act("approve", "Approved."))" Variant="Variant.Filled" Color="Color.Success" Disabled="Api.Busy">Approve</MudButton>
            </AuthorizeView>
        }
        @if (_po.Status == "Approved")
        {
            <AuthorizeView Roles="@Buyers">
                <MudButton OnClick="@(() => Act("send", "Marked as sent to the supplier."))" Variant="Variant.Filled" Color="Color.Primary" Disabled="Api.Busy">Mark sent</MudButton>
            </AuthorizeView>
        }
        @if (_po.Status is "Approved" or "Sent" or "PartiallyReceived")
        {
            <AuthorizeView Roles="@Receivers">
                <MudButton OnClick="Receive" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory" Disabled="Api.Busy">Receive goods</MudButton>
            </AuthorizeView>
        }
        @if (_po.Status == "PartiallyReceived")
        {
            <AuthorizeView Roles="@Buyers">
                <MudButton OnClick="CloseShort" Variant="Variant.Outlined" Disabled="Api.Busy">Close short</MudButton>
            </AuthorizeView>
        }
        @if (_po.Status is "Draft" or "PendingApproval" or "Approved" or "Sent")
        {
            <AuthorizeView Roles="@Buyers">
                <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Error" Disabled="Api.Busy">Cancel</MudButton>
            </AuthorizeView>
        }
    </Actions>
</PageHeader>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">@_po.SupplierName</MudText>
            <MudDataGrid T="PurchaseOrderLine" Items="_po.Lines"
                         Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
                <Columns>
                    <TemplateColumn Title="Item"><CellTemplate>@context.Item.Sku · @context.Item.ItemName</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Ordered" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Qty(context.Item.Quantity) @context.Item.Unit</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Received" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Qty(context.Item.ReceivedQuantity)</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="To come" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Qty(context.Item.Outstanding)</CellTemplate></TemplateColumn>
                    @(MoneyColumn.Of<PurchaseOrderLine>("Unit cost", x => x.UnitCost))
                    @(MoneyColumn.Of<PurchaseOrderLine>("Amount", x => x.LineTotal))
                </Columns>
            </MudDataGrid>
            <Totals>
                <TotalLine Label="Total" Amount="_po.Total" Strong="true" />
            </Totals>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Details</MudText>
            <MudText Typo="Typo.body2">Created by @_createdBy, @Format.Date(_po.CreatedUtc)</MudText>
            @if (_po.SubmittedUtc is not null) { <MudText Typo="Typo.body2">Submitted @Format.Date(_po.SubmittedUtc)</MudText> }
            @if (_po.ApprovedUtc is not null)
            {
                <MudText Typo="Typo.body2">Approved by @(_approvedBy ?? "automatic approval (within the approval limit)"), @Format.Date(_po.ApprovedUtc)</MudText>
            }
            @if (_po.RejectionReason is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Sent back by @_rejectedBy: @_po.RejectionReason</MudAlert>
            }
            @if (_po.SentUtc is not null) { <MudText Typo="Typo.body2">Sent @Format.Date(_po.SentUtc)</MudText> }
            @if (_po.ExpectedDate is { } d) { <MudText Typo="Typo.body2">Expected @Format.Date(d)</MudText> }
            @if (_po.Notes is not null) { <MudText Typo="Typo.body2" Class="mt-2">@_po.Notes</MudText> }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long Id { get; set; }

    private static readonly string Buyers = $"{Roles.Purchaser},{Roles.Admin}";
    private static readonly string Receivers = $"{Roles.InventoryClerk},{Roles.Purchaser},{Roles.Admin}";
    private PurchaseOrderDetail? _po;
    private string? _createdBy, _approvedBy, _rejectedBy;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        _po = await Api.Get<PurchaseOrderDetail>($"api/purchase-orders/{Id}");
        if (_po is null) { Nav.NavigateTo(Lists.Last("purchase-orders")); return; }
        _createdBy = await Users.NameOf(_po.CreatedBy);
        _approvedBy = _po.ApprovedBy is null ? null : await Users.NameOf(_po.ApprovedBy);
        _rejectedBy = _po.RejectedBy is null ? null : await Users.NameOf(_po.RejectedBy);
    }

    private async Task Act(string action, string message)
    {
        if (await Api.Post($"api/purchase-orders/{Id}/{action}", success: message)) await Load();
    }

    private Task Submit() => Act("submit", "Submitted. Within the approval limit it's approved at once.");

    private async Task Reject()
    {
        if (await ReasonDialog.Ask(Dialogs, "Send back", "Tell the buyer what to change. It returns to them as a draft.", "Send back") is { } reason
            && await Api.Post($"api/purchase-orders/{Id}/reject", new { reason }, "Sent back to the buyer."))
            await Load();
    }

    // The two ends that can't be undone ask first.
    private async Task CloseShort()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Close short",
            $"Close {_po!.Number} with what has arrived? The rest is no longer expected. This can't be undone.",
            yesText: "Close short", cancelText: "Keep waiting");
        if (confirmed == true) await Act("close", "Closed: the rest won't come.");
    }

    private async Task Cancel()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Cancel purchase order",
            $"Cancel {_po!.Number}? The supplier should be told separately. This can't be undone.",
            yesText: "Cancel order", cancelText: "Keep it");
        if (confirmed == true) await Act("cancel", "Cancelled.");
    }

    private async Task Receive()
    {
        var dialog = await Dialogs.ShowAsync<ReceiveDialog>($"Receive goods for {_po!.Number}",
            new DialogParameters<ReceiveDialog> { { d => d.Order, _po } }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }
}
