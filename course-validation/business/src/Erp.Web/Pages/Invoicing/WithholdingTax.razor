@page "/withholding-tax"
@attribute [Authorize(Roles = $"{Roles.Accountant},{Roles.Admin}")]
@inject ApiClient Api
@inject IDialogService Dialogs

<PageTitle>Withholding tax · ERP</PageTitle>

<PageHeader Title="Withholding tax (BIR Form 2307)">
    <Actions>
        <MudNumericField T="int" Value="_year" ValueChanged="OnYear" Label="Year" Style="max-width:120px"
                         Variant="Variant.Outlined" Margin="Margin.Normal" />
    </Actions>
</PageHeader>
<MudText Typo="Typo.body2" Class="mb-4">
    Tax customers withheld from their payments, and the certificates they've sent for it. Each 2307 is a credit against
    the business's income tax, so chase the missing ones.
</MudText>

@if (_report is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudDataGrid T="WithholdingRow" Items="_report.Summary" Class="mb-6"
                 Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
        <Columns>
            <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
            <TemplateColumn Title="Quarter"><CellTemplate>Q@(context.Item.Quarter)</CellTemplate></TemplateColumn>
            <MoneyColumn Title="Withheld" Amount="x => x.Withheld" />
            <MoneyColumn Title="Certified" Amount="x => x.Certified" />
            <MoneyColumn Title="Missing" Amount="x => x.Missing" Warn="true" />
            <TemplateColumn Title="">
                <CellTemplate>
                    @if (context.Item.Missing > 0)
                    {
                        <MudButton Size="Size.Small" OnClick="() => Record(context.Item)">Record 2307</MudButton>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>No tax withheld in @_year.</NoRecordsContent>
    </MudDataGrid>

    <MudText Typo="Typo.h6" GutterBottom="true">Certificates received</MudText>
    <MudDataGrid T="WithholdingCertificate" Items="_report.Certificates" RowClassFunc="@((c, _) => c.VoidedUtc is null ? "" : "voided")"
                 Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
        <Columns>
            <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
            <TemplateColumn Title="Quarter"><CellTemplate>Q@(context.Item.Quarter)</CellTemplate></TemplateColumn>
            <MoneyColumn Title="Amount" Amount="x => x.Amount" />
            <TemplateColumn Title="Reference" CellClass="wrap">
                <CellTemplate>@context.Item.Reference @(context.Item.VoidReason is null ? "" : $"(void: {context.Item.VoidReason})")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Received"><CellTemplate>@Format.Date(context.Item.ReceivedOn)</CellTemplate></TemplateColumn>
            <TemplateColumn Title="">
                <CellTemplate>
                    @if (context.Item.VoidedUtc is null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" OnClick="() => Void(context.Item)" aria-label="Void certificate" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>No certificates received yet.</NoRecordsContent>
    </MudDataGrid>
}

@code {
    private int _year = DateTime.Today.Year;
    private WithholdingReport? _report;

    protected override Task OnInitializedAsync() => Load();

    private async Task OnYear(int year) { _year = year; await Load(); }

    private async Task Load() => _report = await Api.Get<WithholdingReport>($"api/withholding-tax?year={_year}");

    private async Task Record(WithholdingRow row)
    {
        var parameters = new DialogParameters<CertificateDialog> { { x => x.Row, row }, { x => x.Year, _year } };
        var dialog = await Dialogs.ShowAsync<CertificateDialog>($"BIR Form 2307 from {row.CustomerName}", parameters);
        if (await dialog.Result is { Canceled: false }) await Load();
    }

    private async Task Void(WithholdingCertificate certificate)
    {
        if (await ReasonDialog.Ask(Dialogs, "Void certificate", $"Void the {Format.Peso(certificate.Amount)} certificate?", "Void") is { } reason
            && await Api.Post($"api/withholding-certificates/{certificate.Id}/void", new { reason }, "Certificate voided."))
            await Load();
    }
}
