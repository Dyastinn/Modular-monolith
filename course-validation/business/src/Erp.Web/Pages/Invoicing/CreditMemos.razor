@page "/credit-memos"
@attribute [Authorize(Roles = $"{Roles.Accountant},{Roles.Admin},{Roles.SalesManager}")]
@inject ApiClient Api
@inject ListAddress View
@inject NavigationManager Nav

<PageTitle>Credit memos · ERP</PageTitle>

<PageHeader Title="Credit memos">
    <Description>Goods taken back and billing corrected. A credit memo is issued from its invoice; refunds still to pay are flagged here.</Description>
</PageHeader>

<MudStack Row="true" Spacing="4" Class="mb-4" Breakpoint="Breakpoint.Xs" AlignItems="AlignItems.Center">
    <MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="Memo, invoice or customer" DebounceInterval="400" Clearable="true"
                  Variant="Variant.Outlined" Margin="Margin.Normal" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSwitch T="bool" Value="RefundPending" ValueChanged="OnRefundPending" Label="Refunds to pay" Color="Color.Primary" />
</MudStack>

<MudDataGrid T="CreditMemoSummary" @ref="_table" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize" RowClick="Open" RowStyle="cursor:pointer">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Credit memo" InitialDirection="@View.Initial(nameof(CreditMemoSummary.Number))" />
        <PropertyColumn Property="x => x.CustomerName" Title="Customer" InitialDirection="@View.Initial(nameof(CreditMemoSummary.CustomerName))" />
        <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice" Sortable="false" />
        <PropertyColumn Property="x => x.IssueDate" Title="Issued" InitialDirection="@View.Initial(nameof(CreditMemoSummary.IssueDate))">
            <CellTemplate>@Format.Date(context.Item.IssueDate)</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Reason" Title="Reason" Sortable="false" CellClass="wrap" />
        @(MoneyColumn.Of<CreditMemoSummary>("Total", x => x.Total, initial: View.Initial(nameof(CreditMemoSummary.Total))))
        @(MoneyColumn.Of<CreditMemoSummary>("Refund due", x => x.RefundedOn == null ? x.RefundDue : 0m, warn: true, sortable: false))
    </Columns>
    <NoRecordsContent>No credit memos match.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="CreditMemoSummary" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public bool RefundPending { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private MudDataGrid<CreditMemoSummary> _table = default!;

    private Task<GridData<CreditMemoSummary>> Load(GridState<CreditMemoSummary> state, CancellationToken ct)
    {
        View.Save(state, ("search", Search), ("refundPending", RefundPending));
        return Api.Page<CreditMemoSummary>(Url.With("api/credit-memos", ("search", Search), ("refundPending", RefundPending)), state);
    }

    protected override void OnParametersSet() => View.Check();

    // A memo lives on its invoice's page, with its print link and refund.
    private void Open(DataGridRowClickEventArgs<CreditMemoSummary> row) => Nav.NavigateTo($"invoices/{row.Item.InvoiceId}");
    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }
    private Task OnRefundPending(bool value) { RefundPending = value; return _table.FirstPage(); }
}
