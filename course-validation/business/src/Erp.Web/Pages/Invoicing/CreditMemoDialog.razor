@inject ApiClient Api

@* Goods came back, or the invoice billed too much: credit part or all of it. What's still owed is reduced first; what the
   customer already paid becomes a refund due. A credit memo can't be undone, so the dialog says what will happen. *@
<MudDialog>
    <DialogContent>
        @if (Whole)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                This invoice has a @Invoice.SpecialDiscount!.Program.ToLower() discount, so it is credited whole.
            </MudAlert>
        }
        <MudDataGrid T="Entry" Items="_lines" Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="Item" CellClass="wrap"><CellTemplate>@context.Item.Line.Description</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Left to credit" HeaderClass="money" CellClass="money">
                    <CellTemplate>@Format.Qty(context.Item.Line.Remaining) @context.Item.Line.Unit</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Credit now">
                    <CellTemplate>
                        <MudNumericField T="decimal" @bind-Value="context.Item.Quantity" Min="0" Max="context.Item.Line.Remaining" Disabled="Whole"
                                         Label="@($"Credit now: {context.Item.Line.Description}")" Style="max-width:140px"
                                         Variant="Variant.Outlined" Margin="Margin.Normal" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
        <MudTextField @bind-Value="_reason" Label="Reason" MaxLength="500" Lines="2" Required="true"
                      HelperText="Printed on the credit memo: returned unopened, wrong price, damaged in delivery"
                      Variant="Variant.Outlined" Margin="Margin.Normal" />
        <MudSwitch T="bool" @bind-Value="_returnToStock" Color="Color.Primary"
                   Label="The goods came back and can be sold again (put them back in stock)" />
        <MudText Class="mt-2">
            Credit @Format.Peso(Total)@(Refund > 0 ? $": {Format.Peso(Total - Refund)} off what's owed, {Format.Peso(Refund)} to refund." : " off what's owed.")
            This can't be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Not now</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(Total == 0 || string.IsNullOrWhiteSpace(_reason) || Api.Busy)">Issue credit memo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public InvoiceDetail Invoice { get; set; } = default!;

    private sealed class Entry(InvoiceLine line, bool whole)
    {
        public InvoiceLine Line { get; } = line;
        public decimal Quantity { get; set; } = whole ? line.Remaining : 0;
    }

    private List<Entry> _lines = [];
    private string _reason = "";
    private bool _returnToStock = true;

    private bool Whole => Invoice.SpecialDiscount is not null;
    // A preview: the API works out the exact figures, VAT and all.
    private decimal Total => Whole ? Invoice.Total : _lines.Sum(l => Math.Round(l.Quantity * l.Line.UnitPrice, 2, MidpointRounding.AwayFromZero));
    private decimal Refund => Math.Max(0, Total - Invoice.BalanceDue);

    protected override void OnInitialized() => _lines = Invoice.Lines.Where(l => l.Remaining > 0).Select(l => new Entry(l, Whole)).ToList();

    private async Task Save()
    {
        var lines = _lines.Where(l => l.Quantity > 0).Select(l => new { lineId = l.Line.Id, quantity = l.Quantity }).ToList();
        if (await Api.Create($"api/invoices/{Invoice.Id}/credit-memos", new { lines, reason = _reason, returnToStock = _returnToStock },
                "Credit memo issued.") is not null)
            Dialog.Close(DialogResult.Ok(true));
    }
}
