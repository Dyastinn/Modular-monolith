@page "/invoices"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Invoices · ERP</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Invoices</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Every shipment is invoiced automatically, a few seconds after it leaves.</MudText>

<MudStack Row="true" Spacing="4" Class="mb-4" Wrap="Wrap.Wrap">
    <MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="Invoice, order or customer" DebounceInterval="400" Clearable="true" />
    <MudSelect T="string" Value="_status" ValueChanged="OnStatus" Label="Status" Clearable="true" Style="max-width:200px">
        @foreach (var s in Statuses)
        {
            <MudSelectItem Value="s">@Format.Words(s)</MudSelectItem>
        }
    </MudSelect>
    <MudSwitch T="bool" Value="OverdueOnly" ValueChanged="OnOverdue" Label="Overdue only" Color="Color.Error" />
</MudStack>

<MudTable T="InvoiceSummary" @ref="_table" ServerData="Load" Hover="true" Dense="true" OnRowClick="Open" RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh>Invoice</MudTh><MudTh>Customer</MudTh><MudTh>Order</MudTh><MudTh>Issued</MudTh><MudTh>Due</MudTh>
        <MudTh>Status</MudTh><MudTh Class="money">Total</MudTh><MudTh Class="money">Balance</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.CustomerName</MudTd>
        <MudTd>@context.OrderNumber</MudTd>
        <MudTd>@Format.Date(context.IssueDate)</MudTd>
        <MudTd>@Format.Date(context.DueDate)</MudTd>
        <MudTd><StatusChip Status="@context.Status" /></MudTd>
        <MudTd Class="money">@Format.Peso(context.Total)</MudTd>
        <MudTd Class="money">@Format.Peso(context.BalanceDue)</MudTd>
    </RowTemplate>
    <NoRecordsContent>No invoices match.</NoRecordsContent>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public bool OverdueOnly { get; set; }

    private static readonly string[] Statuses = ["Issued", "PartiallyPaid", "Paid", "Void"];
    private MudTable<InvoiceSummary> _table = default!;
    private string? _status;

    private Task<TableData<InvoiceSummary>> Load(TableState state, CancellationToken ct) =>
        Api.Page<InvoiceSummary>(Url.With("api/invoices", ("search", Search), ("status", _status), ("overdueOnly", OverdueOnly)), state);

    private void Open(TableRowClickEventArgs<InvoiceSummary> row) => Nav.NavigateTo($"invoices/{row.Item!.Id}");
    private Task OnSearch(string? text) { Search = text; return _table.ReloadServerData(); }
    private Task OnStatus(string? status) { _status = status; return _table.ReloadServerData(); }
    private Task OnOverdue(bool value) { OverdueOnly = value; return _table.ReloadServerData(); }
}
