@page "/invoices"
@inject ApiClient Api
@inject ListAddress View
@inject NavigationManager Nav

<PageTitle>Invoices · ERP</PageTitle>

<PageHeader Title="Invoices">
    <Description>Every shipment is invoiced automatically, a few seconds after it leaves.</Description>
</PageHeader>

<MudStack Row="true" Spacing="4" Class="mb-4" Wrap="Wrap.Wrap" Breakpoint="Breakpoint.Xs">
    <MudTextField T="string" Value="Search" ValueChanged="OnSearch" Label="Invoice, order or customer" DebounceInterval="400" Clearable="true"
                  Variant="Variant.Outlined" Margin="Margin.Normal" />
    <MudSelect T="string" Value="Status" ValueChanged="OnStatus" Label="Status" Clearable="true" Style="max-width:200px"
               Variant="Variant.Outlined" Margin="Margin.Normal">
        @foreach (var s in Statuses)
        {
            <MudSelectItem Value="s">@Format.Words(s)</MudSelectItem>
        }
    </MudSelect>
    <MudSwitch T="bool" Value="OverdueOnly" ValueChanged="OnOverdue" Label="Overdue only" Color="Color.Error" />
</MudStack>

<MudDataGrid T="InvoiceSummary" @ref="_table" @key="View.Version" ServerData="Load"
             Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false"
             CurrentPage="ListAddress.PageIndex(PageNumber)" RowsPerPage="PageSize ?? ListAddress.DefaultPageSize" RowClick="Open" RowStyle="cursor:pointer">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Invoice" InitialDirection="@View.Initial(nameof(InvoiceSummary.Number))" />
        <PropertyColumn Property="x => x.CustomerName" Title="Customer" InitialDirection="@View.Initial(nameof(InvoiceSummary.CustomerName))" />
        @* An opening balance has the customer's old invoice number here instead of an order. *@
        <PropertyColumn Property="x => x.OrderNumber" Title="Order" Sortable="false">
            <CellTemplate>@context.Item.OrderNumber @if (context.Item.IsOpeningBalance) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Opening balance</MudChip> }</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IssueDate" Title="Issued" InitialDirection="@View.Initial(nameof(InvoiceSummary.IssueDate))">
            <CellTemplate>@Format.Date(context.Item.IssueDate)</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.DueDate" Title="Due" InitialDirection="@View.Initial(nameof(InvoiceSummary.DueDate))">
            <CellTemplate>@Format.Date(context.Item.DueDate)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Status"><CellTemplate><StatusChip Status="@context.Item.Status" /></CellTemplate></TemplateColumn>
        @(MoneyColumn.Of<InvoiceSummary>("Total", x => x.Total, initial: View.Initial(nameof(InvoiceSummary.Total))))
        @(MoneyColumn.Of<InvoiceSummary>("Balance", x => x.BalanceDue, initial: View.Initial(nameof(InvoiceSummary.BalanceDue))))
    </Columns>
    <NoRecordsContent>No invoices match.</NoRecordsContent>
    <PagerContent><MudDataGridPager T="InvoiceSummary" /></PagerContent>
</MudDataGrid>

@code {
    // The list's view lives in the address (see ListAddress).
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public bool OverdueOnly { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? PageSize { get; set; }

    private static readonly string[] Statuses = ["Issued", "PartiallyPaid", "Paid", "Credited", "Void"];
    private MudDataGrid<InvoiceSummary> _table = default!;

    private Task<GridData<InvoiceSummary>> Load(GridState<InvoiceSummary> state, CancellationToken ct)
    {
        View.Save(state, ("search", Search), ("status", Status), ("overdueOnly", OverdueOnly));
        return Api.Page<InvoiceSummary>(Url.With("api/invoices", ("search", Search), ("status", Status), ("overdueOnly", OverdueOnly)), state);
    }

    // A link to this list with other filters (the menu, a home tile, Back) shows them.
    protected override void OnParametersSet() => View.Check();

    private void Open(DataGridRowClickEventArgs<InvoiceSummary> row) => Nav.NavigateTo($"invoices/{row.Item.Id}");
    private Task OnSearch(string? text) { Search = text; return _table.FirstPage(); }
    private Task OnStatus(string? status) { Status = status; return _table.FirstPage(); }
    private Task OnOverdue(bool value) { OverdueOnly = value; return _table.FirstPage(); }
}
