@page "/invoices/{Id:long}"
@inject ApiClient Api
@inject ListMemory Lists
@inject UserDirectory Users
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_invoice?.Number ?? "Invoice") · ERP</PageTitle>

@if (_invoice is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PageHeader Title="@_invoice.Number" Trail="@([new BreadcrumbItem("Invoices", Lists.Last("invoices")), new BreadcrumbItem(_invoice.Number, null, disabled: true)])">
    <Status><StatusChip Status="@_invoice.Status" Live="true" /></Status>
    <Actions>
        @* An opening balance isn't a BIR invoice: it's never printed, and a wrong one is voided and recorded again. *@
        @if (!_invoice.IsOpeningBalance)
        {
            <MudButton Href="@($"api/invoices/{Id}/pdf")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf">
                @(_invoice.PrintCount == 0 ? "Print" : "Reprint")
            </MudButton>
        }
        <AuthorizeView Roles="@Accountants">
            @if (_invoice.Status is "Issued" or "PartiallyPaid")
            {
                <MudButton OnClick="RecordPayment" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" Disabled="Api.Busy">Record payment</MudButton>
            }
            @if (!_invoice.IsOpeningBalance && _invoice.Status != "Void" && _invoice.Lines.Any(l => l.Remaining > 0))
            {
                <MudButton OnClick="IssueCreditMemo" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AssignmentReturn" Disabled="Api.Busy">Credit memo</MudButton>
            }
            @if (_invoice.Status == "Issued" && _invoice.CreditMemos.Count == 0)
            {
                <MudButton OnClick="Void" Variant="Variant.Text" Color="Color.Error" Disabled="Api.Busy">Void</MudButton>
            }
            @if (_invoice.Status == "Void" && !_invoice.IsOpeningBalance)
            {
                <MudButton OnClick="Reissue" Variant="Variant.Filled" Color="Color.Primary" Disabled="Api.Busy">Issue a replacement</MudButton>
            }
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_invoice.IsOpeningBalance)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        An opening balance: what @_invoice.CustomerName still owed on their invoice @_invoice.OrderNumber when the system went live.
        It takes payments like an invoice, but isn't a sale.
    </MudAlert>
}
@if (_invoice.VoidReason is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Void: @_invoice.VoidReason</MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudText Typo="Typo.h6">@_invoice.CustomerName</MudText>
            <MudText Typo="Typo.body2">@(_invoice.CustomerTin is null ? "" : $"TIN {_invoice.CustomerTin} · ")@_invoice.CustomerAddress</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Order @_invoice.OrderNumber · Issued @Format.Date(_invoice.IssueDate) · Due @Format.Date(_invoice.DueDate)</MudText>
            <MudDataGrid T="InvoiceLine" Items="_invoice.Lines"
                         Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
                <Columns>
                    <TemplateColumn Title="Description" CellClass="wrap">
                        <CellTemplate>
                            @(context.Item.SpecialDiscountEligible && _invoice.SpecialDiscount is not null ? "* " : "")@context.Item.Description
                            @(context.Item.TaxType == "Vatable" ? "" : $"({Format.Words(context.Item.TaxType).ToLower()})")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Quantity" HeaderClass="money" CellClass="money"><CellTemplate>@Format.Qty(context.Item.Quantity) @context.Item.Unit</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Credited" HeaderClass="money" CellClass="money" Hidden="@(_invoice.Credited == 0 && _invoice.CreditMemos.Count == 0)">
                        <CellTemplate>@Format.Qty(context.Item.CreditedQuantity)</CellTemplate>
                    </TemplateColumn>
                    @(MoneyColumn.Of<InvoiceLine>("Unit price", x => x.UnitPrice))
                    @(MoneyColumn.Of<InvoiceLine>("Amount", x => x.LineTotal))
                </Columns>
            </MudDataGrid>
            <Totals>
                @if (_invoice.TaxRegime == "Vat")
                {
                    <TotalLine Label="VATable sales" Amount="_invoice.VatableSales" />
                    <TotalLine Label="@($"VAT ({(_invoice.VatRate * 100).ToString("0.##")}%)")" Amount="_invoice.VatAmount" />
                    <TotalLine Label="Zero-rated sales" Amount="_invoice.ZeroRatedSales" />
                    <TotalLine Label="VAT-exempt sales" Amount="_invoice.VatExemptSales" />
                }
                else if (_invoice.TaxRegime == "PercentageTax")
                {
                    <TotalLine Label="Sales subject to percentage tax" Amount="_invoice.GrossSales - _invoice.VatExemptSales" />
                    <TotalLine Label="Exempt sales" Amount="_invoice.VatExemptSales" />
                }
                @if (_invoice.SpecialDiscount is { } d)
                {
                    @if (d.VatExemption > 0)
                    {
                        <TotalLine Label="Less: VAT exemption (* items)" Amount="d.VatExemption" />
                    }
                    <TotalLine Label="@($"Less: {Format.Percent(d.Rate)} {d.Program.ToLower()} discount · {d.HolderName}, {d.IdLabel} {d.IdNumber}")" Amount="d.Discount" />
                }
                <MudDivider Class="my-1" />
                <TotalLine Label="Total" Amount="_invoice.Total" Strong="true" />
                <TotalLine Label="Paid" Amount="_invoice.AmountPaid" />
                @if (_invoice.Credited > 0)
                {
                    <TotalLine Label="Credited" Amount="_invoice.Credited" />
                }
                <TotalLine Label="Balance due" Amount="_invoice.BalanceDue" Strong="true" />
            </Totals>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Payments</MudText>
            @if (_invoice.Payments.Count == 0)
            {
                <MudText Typo="Typo.body2">None yet.</MudText>
            }
            @foreach (var p in _invoice.Payments)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Class="@(p.VoidedUtc is null ? "" : "voided")">
                            @Format.Peso(p.Amount) · @Format.Words(p.Method) · @Format.Date(p.PaidOn)
                            @(p.TaxWithheld > 0 ? $" + {Format.Peso(p.TaxWithheld)} withheld (2307)" : "")
                        </MudText>
                        <MudText Typo="Typo.caption">@p.Reference @(p.VoidReason is null ? "" : $"(void: {p.VoidReason})")</MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (p.VoidedUtc is null)
                    {
                        <AuthorizeView Roles="@Accountants" Context="auth">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" OnClick="() => VoidPayment(p)" aria-label="Void payment" Disabled="Api.Busy" />
                        </AuthorizeView>
                    }
                </MudStack>
            }
        </MudPaper>
        @if (_invoice.CreditMemos.Count > 0)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true">
                <MudText Typo="Typo.h6" GutterBottom="true">Credit memos</MudText>
                @foreach (var m in _invoice.CreditMemos)
                {
                    <MudStack Spacing="0" Class="mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudLink Href="@($"api/credit-memos/{m.Id}/pdf")" Target="_blank">@m.Number</MudLink>
                            <MudText Typo="Typo.body2">@Format.Peso(m.Total) · @Format.Date(m.IssueDate)</MudText>
                            <MudSpacer />
                            @if (m.RefundDue > 0 && m.RefundedOn is null)
                            {
                                <AuthorizeView Roles="@Accountants" Context="auth">
                                    <MudButton Size="Size.Small" OnClick="() => RecordRefund(m)" Disabled="Api.Busy">Record refund</MudButton>
                                </AuthorizeView>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption">
                            @m.Reason@(m.ReturnToStock ? " · back in stock" : "")@(m.RefundDue > 0 ? $" · refund {Format.Peso(m.RefundDue)}{(m.RefundedOn is { } on ? $" paid {Format.Date(on)}" : " due")}" : "")
                        </MudText>
                    </MudStack>
                }
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long Id { get; set; }

    private static readonly string Accountants = $"{Roles.Accountant},{Roles.Admin}";
    private InvoiceDetail? _invoice;

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        _invoice = await Api.Get<InvoiceDetail>($"api/invoices/{Id}");
        if (_invoice is null) Nav.NavigateTo(Lists.Last("invoices"));
    }

    private async Task RecordPayment()
    {
        var dialog = await Dialogs.ShowAsync<PaymentDialog>($"Payment for {_invoice!.Number}",
            new DialogParameters<PaymentDialog> { { d => d.Invoice, _invoice } });
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task VoidPayment(Payment payment)
    {
        if (await ReasonDialog.Ask(Dialogs, "Void payment", $"Void the {Format.Peso(payment.Amount + payment.TaxWithheld)} payment? The customer owes it again.", "Void")
                is { } reason
            && await Api.Post($"api/invoices/{Id}/payments/{payment.Id}/void", new { reason }, "Payment voided."))
            await Load();
    }

    private async Task Void()
    {
        if (await ReasonDialog.Ask(Dialogs, "Void invoice", "The invoice number stays used, marked void. You can then issue a replacement.", "Void")
                is { } reason
            && await Api.Post($"api/invoices/{Id}/void", new { reason }, "Invoice voided."))
            await Load();
    }

    private async Task IssueCreditMemo()
    {
        var dialog = await Dialogs.ShowAsync<CreditMemoDialog>($"Credit memo for {_invoice!.Number}",
            new DialogParameters<CreditMemoDialog> { { d => d.Invoice, _invoice } }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task RecordRefund(InvoiceCreditMemo memo)
    {
        var dialog = await Dialogs.ShowAsync<RefundDialog>($"Refund for {memo.Number}", new DialogParameters<RefundDialog> { { d => d.Memo, memo } });
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task Reissue()
    {
        if (await Api.Create($"api/invoices/{Id}/reissue", new { }, "Replacement issued.") is { } newId)
            Nav.NavigateTo($"invoices/{newId}");
    }
}
