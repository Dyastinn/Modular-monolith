@page "/receivables-aging"
@attribute [Authorize(Roles = $"{Roles.Accountant},{Roles.Admin},{Roles.SalesManager}")]
@inject ApiClient Api

<PageTitle>Receivables aging · ERP</PageTitle>

<PageHeader Title="Receivables aging">
    <Actions>
        <MudDatePicker Date="_asOf" DateChanged="OnDate" Label="As of" Style="max-width:200px"
                       Variant="Variant.Outlined" Margin="Margin.Normal" Editable="true" />
    </Actions>
</PageHeader>

@if (_report is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudDataGrid T="AgingRow" Items="_report.Customers"
                 Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.Single" ShowColumnOptions="false">
        <Columns>
            <PropertyColumn Property="x => x.CustomerName" Title="Customer">
                <CellTemplate>
                    <MudLink Href="@($"invoices?search={Uri.EscapeDataString(context.Item.CustomerName)}")">@context.Item.CustomerName</MudLink>
                </CellTemplate>
                <FooterTemplate>Total</FooterTemplate>
            </PropertyColumn>
            @(MoneyColumn.Of<AgingRow>("Not yet due", r => r.NotYetDue, total: _report.Totals.NotYetDue))
            @(MoneyColumn.Of<AgingRow>("1–30 days", r => r.Days1To30, total: _report.Totals.Days1To30))
            @(MoneyColumn.Of<AgingRow>("31–60", r => r.Days31To60, total: _report.Totals.Days31To60))
            @(MoneyColumn.Of<AgingRow>("61–90", r => r.Days61To90, total: _report.Totals.Days61To90))
            @(MoneyColumn.Of<AgingRow>("Over 90", r => r.Over90, total: _report.Totals.Over90, warn: true))
            @(MoneyColumn.Of<AgingRow>("Total", r => r.Total, total: _report.Totals.Total))
        </Columns>
        <NoRecordsContent>Nobody owes anything on this date.</NoRecordsContent>
    </MudDataGrid>
}

@code {
    private DateTime? _asOf = DateTime.Today;
    private AgingReport? _report;

    protected override Task OnInitializedAsync() => Load();

    private async Task OnDate(DateTime? date) { _asOf = date ?? DateTime.Today; await Load(); }

    private async Task Load() =>
        _report = await Api.Get<AgingReport>($"api/reports/receivables-aging?asOf={_asOf:yyyy-MM-dd}");
}
