@inject ApiClient Api

@* One kind of import: pick a CSV file, see what's wrong row by row, check it with the server, then import it all at
   once. Nothing is saved until Import, and then only if every row is accepted. *@
<MudStack Spacing="3">
    @Help
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButton Href="@Template" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download"
                   UserAttributes="@(new Dictionary<string, object> { ["download"] = $"{FileName}-template.csv" })">Template</MudButton>
        @* CustomContent replaces MudBlazor's own "Browse files" button; the chosen file's name shows beside it instead of a chip. *@
        <MudFileUpload T="IBrowserFile" Accept=".csv,text/csv" FilesChanged="Read" SelectedTemplate="NoChips">
            <CustomContent>
                <MudButton OnClick="@context.OpenFilePickerAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">Choose a CSV file</MudButton>
            </CustomContent>
        </MudFileUpload>
        @if (_file is not null)
        {
            <MudText Typo="Typo.body2">@_file: @Rows(_rowCount)</MudText>
        }
        <MudSpacer />
        <MudButton OnClick="Check" Variant="Variant.Outlined" Disabled="@(_rows.Count == 0 || _errors.Count > 0 && _checked is null || Api.Busy)">Check</MudButton>
        <MudButton OnClick="Import" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_checked is not { Errors.Count: 0 } || Api.Busy)">Import</MudButton>
    </MudStack>

    @if (_imported is { } done)
    {
        <MudAlert Severity="Severity.Success">Imported @Rows(done).</MudAlert>
    }
    else if (_checked is { Errors.Count: 0 })
    {
        <MudAlert Severity="Severity.Info">@(_rowCount == 1 ? "The row is fine." : $"All {_rowCount} rows are fine.") Import saves them all at once.</MudAlert>
    }
    @if (_errors.Count > 0)
    {
        <MudAlert Severity="Severity.Warning">@Rows(_errors.Count) to fix. Correct the file and choose it again; nothing was saved.</MudAlert>
        <MudDataGrid T="ImportError" Items="_errors" Outlined="true" Striped="true" Hover="true" Dense="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="x => x.Row" Title="Row" />
                <PropertyColumn Property="x => x.Message" Title="Problem" CellClass="wrap" />
                <TemplateColumn Title="Code">
                    <CellTemplate>
                        @if (context.Item.Code is { } errorCode) { <MudLink Href="@($"errors/{errorCode}")">@errorCode</MudLink> }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    [Parameter, EditorRequired] public string[] Columns { get; set; } = [];
    // One CSV row (by column name) to what the API takes, or a message saying what's wrong with it.
    [Parameter, EditorRequired] public Func<Dictionary<string, string>, (object? Row, string? Error)> Convert { get; set; } = default!;
    [Parameter] public RenderFragment? Help { get; set; }

    private const long MaxFileBytes = 10 * 1024 * 1024;
    private static readonly RenderFragment<IBrowserFile?> NoChips = _ => _ => { };
    private string? _file;
    private List<object> _rows = [];
    private List<ImportError> _errors = [];
    private ImportResult? _checked;
    private int? _imported;
    private int _rowCount;

    private static string Rows(int n) => n == 1 ? "1 row" : $"{n} rows";

    private string Template => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(Csv.Header(Columns));

    private async Task Read(IBrowserFile? file)
    {
        if (file is null) return;
        (_file, _rows, _errors, _checked, _imported) = (file.Name, [], [], null, null);
        using var reader = new StreamReader(file.OpenReadStream(MaxFileBytes));
        var lines = Csv.Read(await reader.ReadToEndAsync());
        _rowCount = lines.Count;
        for (var i = 0; i < lines.Count; i++)
        {
            var (row, error) = Convert(lines[i]);
            if (row is not null) _rows.Add(row);
            else _errors.Add(new ImportError(i + 1, error!, null));
        }
    }

    private Task Check() => Send(commit: false);
    private Task Import() => Send(commit: true);

    private async Task Send(bool commit)
    {
        if (await Api.PostFor<ImportResult>(Url, new { rows = _rows, commit }) is not { } result) return;
        _errors = result.Errors;
        _checked = result;
        if (commit && result.Errors.Count == 0) (_imported, _rows, _checked) = (result.Imported, [], null);
    }
}
