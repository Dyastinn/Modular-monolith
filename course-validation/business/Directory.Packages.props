<Project>
  <!-- Buyers of the source inherit every license here: permissive and free only. Record each in THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version pinned here also wins for transitive dependencies (security patches). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web / endpoints -->
    <PackageVersion Include="Carter" Version="10.0.0" />                                   <!-- MIT -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />                   <!-- MIT -->

    <!-- Mediator (source-generated) -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />                     <!-- MIT -->
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />                  <!-- MIT -->

    <!-- Data: PostgreSQL. EF Core for writes, Dapper for reads -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />            <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" /> <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />     <!-- MIT -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />     <!-- PostgreSQL license (permissive) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />                                    <!-- PostgreSQL license (permissive) -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />                  <!-- Apache-2.0 -->
    <PackageVersion Include="Dapper" Version="2.1.79" />                                    <!-- Apache-2.0 -->

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />                          <!-- Apache-2.0 -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Auth: ASP.NET Core Identity does sign-in, tokens, cookies and lockout -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />       <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" /> <!-- MIT -->

    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />              <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />      <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />            <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />         <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />  <!-- Apache-2.0 -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />                          <!-- PostgreSQL license -->
    <!-- Aspire (MIT, dev-time dashboard only) is versioned by the Sdk attribute in Erp.AppHost.csproj. -->

    <!-- Extensions abstractions -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />        <!-- MIT -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />                  <!-- MIT -->
    <PackageVersion Include="xunit" Version="2.9.3" />                                     <!-- Apache-2.0 -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />                 <!-- Apache-2.0 -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />                        <!-- MIT -->
    <!-- AwesomeAssertions, not FluentAssertions: FluentAssertions 8+ needs a paid license for commercial use. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />                          <!-- Apache-2.0 -->
  </ItemGroup>
</Project>
