<Project>
  <!-- Buyers of the source inherit every license here: permissive and free only. Record each in THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version pinned here also wins for transitive dependencies (security patches). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web: the API description (OpenAPI) and, in development, a page to browse and try it -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />            <!-- MIT -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />                       <!-- MIT -->


    <!-- Data: PostgreSQL. EF Core for writes, Dapper for reads -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />            <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" /> <!-- MIT; pinned so the Npgsql provider (needs ≥ 10.0.4) uses the same EF Core as everything else -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />     <!-- MIT -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />     <!-- PostgreSQL license (permissive) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />                                    <!-- PostgreSQL license (permissive) -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />                  <!-- Apache-2.0 -->
    <PackageVersion Include="Dapper" Version="2.1.79" />                                    <!-- Apache-2.0 -->

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />                          <!-- Apache-2.0 -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Auth: ASP.NET Core Identity does sign-in, tokens, cookies and lockout -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />       <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" /> <!-- MIT -->

    <!-- Email and documents -->
    <PackageVersion Include="MailKit" Version="4.18.2" />                                   <!-- MIT -->
    <!-- 6.2.4 is the LAST MIT release. PDFsharp 6.5+ is AGPL-3.0 and checks for a license at runtime: never upgrade. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />                          <!-- MIT; not QuestPDF (revenue-gated) -->
    <!-- Pinned: PDFsharp asks for 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />        <!-- MIT -->

    <!-- Front end: Blazor WebAssembly, hosted by Erp.Api -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />            <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />     <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />          <!-- MIT -->
    <PackageVersion Include="MudBlazor" Version="9.12.0" />                                               <!-- MIT -->

    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />              <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />      <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />            <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />         <!-- Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />  <!-- Apache-2.0 -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />                          <!-- PostgreSQL license -->
    <!-- Aspire (MIT, dev-time dashboard only) is versioned by the Sdk attribute in Erp.AppHost.csproj. -->


    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />        <!-- MIT -->
    <!-- xUnit v3 runs on Microsoft.Testing.Platform: test projects are executables, opted in by global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />                                  <!-- Apache-2.0 -->
    <!-- AwesomeAssertions, not FluentAssertions: FluentAssertions 8+ needs a paid license for commercial use. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />                          <!-- Apache-2.0 -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />   <!-- MIT -->
    <!-- Browser tests drive the Edge or Chrome already installed; no browser is downloaded. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />                     <!-- MIT -->
    <!-- Property-based tests: hundreds of generated inputs per rule. -->
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />                              <!-- BSD-3-Clause -->
    <!-- Which lines the tests run (the coverlet option of dotnet test). -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />                              <!-- MIT -->
    <!-- A throwaway PostgreSQL per test run, in a Podman (or Docker) container. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />                 <!-- MIT -->
  </ItemGroup>
</Project>
